expected_source_script=00_setup.source_bash

if [ -z "$BASH_SOURCE" ]
then
    printf "script \"%s\" should be sourced from \"%s\"\n"  \
        "$0" "$expected_source_script" 1>&2

    exit 1
fi

this_script=$(basename "${BASH_SOURCE[0]}")
source_script=$(basename "${BASH_SOURCE[1]}")

if [ -z "$source_script" ]
then
    printf "script \"%s\" should be sourced from  \"%s\"\n"  \
        "$this_script" "$expected_source_script" 1>&2

    return 1
fi

if [ "$source_script" != $expected_source_script ]
then
    printf "script \"%s\" should be sourced from  \"%s\", not \"%s\"\n"  \
        "$this_script" "$expected_source_script" "$source_script" 1>&2

    exit 1
fi

#-----------------------------------------------------------------------------

# Vendor directories created by the Xilinx / AMD installers.
#
# Two installation tree layouts are supported, both of them with
# a version directory:
#
#     <parent>/<vendor>/Vivado/<version>  - Vivado 2024.1 and older
#     <parent>/<vendor>/<version>/Vivado  - Vivado 2024.2 and newer

xilinx_vendor_dirs="Xilinx AMD AMDDesignTools"

#-----------------------------------------------------------------------------

# Appends an item to the list kept in the variable named by the first
# argument, using the separator given as the second argument.

xilinx_append_to ()
{
    local list_name="$1"
    local separator="$2"
    local item="$3"
    local list="${!list_name}"

    printf -v "$list_name" '%s' "${list:+$list$separator}$item"
}

#-----------------------------------------------------------------------------

# Remembers "$version<tab>$vivado_dir" if the directory looks like
# a usable Vivado installation. The version goes first, in a field of
# its own, so that the list can be sorted by the version alone.

xilinx_add_vivado_candidate ()
{
    local vivado_dir="$1"
    local version="$2"

    [ -d "$vivado_dir/bin" ] || return 0

    xilinx_append_to vivado_candidates "$xilinx_newline"  \
        "$version$xilinx_tab$vivado_dir"
}

#-----------------------------------------------------------------------------

# A version directory is expected to start with a digit, which keeps
# the DocNav, xic and .xinstall directories of the installer out of the
# search. A directory that otherwise looks like an installation is
# worth a warning, so that it is not ignored silently.

xilinx_warn_about_ignored_dirs ()
{
    local vendor_dir="$1"
    local dir
    local version_dir
    local ignored_dirs=

    [ -z "$vivado_candidates" ] || return 0
    [ -d "$vendor_dir" ]        || return 0

    for dir in "$vendor_dir/Vivado"/* "$vendor_dir"/*/Vivado
    do
        [ -d "$dir/bin" ] || continue

        version_dir=${dir%/Vivado}

        case ${version_dir##*/} in
            [0-9]*) continue ;;
        esac

        xilinx_append_to ignored_dirs " and " "'$dir'"
    done

    [ -n "$ignored_dirs" ] || return 0

    warning "ignoring $ignored_dirs, because the name of a version"  \
            "directory is expected to start with a digit."           \
            "$msg_for_XILINX_VIVADO"
}

#-----------------------------------------------------------------------------

# Looks for Vivado installations of both layouts under a single parent
# directory, trying each of the known vendor directories in turn.
#
# An unmatched pattern stays literal and is rejected by the test for
# a "bin" subdirectory in xilinx_add_vivado_candidate.

xilinx_try_install_dir ()
{
    local parent_dir="$1"
    local vendor
    local dir
    local version_dir

    [ -n "${parent_dir-}" ] || return 0

    # The first parent directory with an installation wins, so that
    # XILINX_HOME takes precedence over the standard locations

    [ -z "$vivado_candidates" ] || return 0

    xilinx_append_to attempt_vivado_install_parent_dirs " or "  \
        "'$parent_dir'"

    for vendor in $xilinx_vendor_dirs
    do
        for dir in "$parent_dir/$vendor/Vivado/"[0-9]*
        do
            xilinx_add_vivado_candidate "$dir" "${dir##*/}"
        done

        for dir in "$parent_dir/$vendor/"[0-9]*/Vivado
        do
            version_dir=${dir%/Vivado}

            xilinx_add_vivado_candidate "$dir" "${version_dir##*/}"
        done

        xilinx_warn_about_ignored_dirs "$parent_dir/$vendor"
    done
}

#-----------------------------------------------------------------------------

# Finds out how to sort version numbers, setting "sort_to_run" and
# "sort_options" in the caller.
#
# The Unix utilities are tried before the "sort" from the path, which
# under Cygwin and MSYS can turn out to be the sort.exe of Microsoft
# Windows. A candidate is accepted only when it really does order
# 2026.2 before 2026.10, and not merely when it takes the "-V" option.

xilinx_sort_discovery ()
{
    local candidate
    local probe
    local expected

    expected="2026.2${xilinx_tab}a${xilinx_newline}2026.10${xilinx_tab}b"

    sort_to_run=sort
    sort_options=()

    for candidate in /usr/bin/sort /bin/sort sort
    do
        probe=$(printf '2026.10\tb\n2026.2\ta\n'  \
            | LC_ALL=C "$candidate" -t "$xilinx_tab" -k1,1V 2>/dev/null)

        if [ "$probe" = "$expected" ]
        then
            sort_to_run="$candidate"
            sort_options=(-t "$xilinx_tab" -k1,1V)
            return
        fi
    done

    warning "no 'sort' with support for the '-V' option is available,"  \
            "so the versions of Vivado are compared as plain strings."  \
            "A version such as 2026.9 is going to be mistakenly"        \
            "considered newer than 2026.10."                            \
            "$msg_for_XILINX_VIVADO"
}

#-----------------------------------------------------------------------------

xilinx_setup_vivado ()
{
       [ "$OSTYPE" = "linux-gnu" ]  \
    || [ "$OSTYPE" = "cygwin"    ]  \
    || [ "$OSTYPE" = "msys"      ]  \
    || return

    #-------------------------------------------------------------------------

    local xilinx_newline=$'\n'
    local xilinx_tab=$'\t'
    local xilinx_vendor_dirs_msg=
    local vivado_candidates=
    local attempt_vivado_install_parent_dirs=
    local msg_for_XILINX_VIVADO
    local extra_msg
    local sorted_candidates
    local chosen_vivado_dir
    local all_vivado_dirs
    local sort_to_run
    local vendor
    local -a sort_options

    for vendor in $xilinx_vendor_dirs
    do
        xilinx_append_to xilinx_vendor_dirs_msg " or " "'$vendor'"
    done

    msg_for_XILINX_VIVADO="You can also use XILINX_VIVADO variable"
    msg_for_XILINX_VIVADO+=" to specify a directory"
    msg_for_XILINX_VIVADO+=" for a specific version of Vivado, such as"
    msg_for_XILINX_VIVADO+=" XILINX_VIVADO=/tools/Xilinx/Vivado/2023.1"
    msg_for_XILINX_VIVADO+=" or XILINX_VIVADO=/tools/AMD/2026.1/Vivado."

    #-------------------------------------------------------------------------

    if [ -n "${XILINX_VIVADO-}" ]
    then
       if [ -d "$XILINX_VIVADO/bin" ]
       then
           export PATH="${PATH:+$PATH:}$XILINX_VIVADO/bin"
           return
       fi

       warning "XILINX_VIVADO variable is set to '$XILINX_VIVADO',"  \
               "but there is no directory '$XILINX_VIVADO/bin'."     \
               "Trying to find Vivado directory elsewhere."          \
               "You can also use XILINX_HOME variable to specify"    \
               "a parent directory of a vendor directory"            \
               "$xilinx_vendor_dirs_msg."
    fi

    #-------------------------------------------------------------------------

    if is_command_available vivado
    then
        return  # Already set up
    fi

    #-------------------------------------------------------------------------

    if [ -n "${XILINX_HOME-}" ]
    then
        xilinx_try_install_dir "$XILINX_HOME"

        if [ -z "$vivado_candidates" ]
        then
            warning "XILINX_HOME variable is set to '$XILINX_HOME',"   \
                    "but there is no Vivado installation under it"     \
                    "in a vendor directory $xilinx_vendor_dirs_msg."   \
                    "Trying to find Xilinx home directory elsewhere."  \
                    "$msg_for_XILINX_VIVADO"
        fi
    fi

    #-------------------------------------------------------------------------

    if [ "$OSTYPE" = "linux-gnu" ]
    then
        xilinx_try_install_dir "$HOME"
        xilinx_try_install_dir /opt
        xilinx_try_install_dir /tools
    else
        xilinx_try_install_dir /c
        xilinx_try_install_dir /d
        xilinx_try_install_dir /e
    fi

    #-------------------------------------------------------------------------

    if [ -z "$vivado_candidates" ]
    then
        extra_msg="A vendor directory $xilinx_vendor_dirs_msg"
        extra_msg+=" is expected to contain either"
        extra_msg+=" 'Vivado/<version>' or '<version>/Vivado'."
        extra_msg+=" Its location (parent directory) can be set"
        extra_msg+=" by the environment variable XILINX_HOME."
        extra_msg+=" $msg_for_XILINX_VIVADO"

        error "expected to find a Vivado installation under"  \
              "$attempt_vivado_install_parent_dirs."          \
              "$extra_msg"
    fi

    #-------------------------------------------------------------------------

    xilinx_sort_discovery

    if ! sorted_candidates=$(printf '%s\n' "$vivado_candidates"  \
        | LC_ALL=C "$sort_to_run" "${sort_options[@]}")
    then
        error "failed to sort the versions of Vivado"  \
              "using '$sort_to_run'"
    fi

    # The sort of Microsoft Windows terminates the lines with CR LF

    sorted_candidates=${sorted_candidates//$'\r'/}

    # The candidates are sorted from the oldest version to the newest,
    # so the directory after the last tab belongs to the newest one

    chosen_vivado_dir=${sorted_candidates##*"$xilinx_tab"}

    export XILINX_VIVADO="$chosen_vivado_dir"
    export PATH="${PATH:+$PATH:}$XILINX_VIVADO/bin"

    #-------------------------------------------------------------------------

    all_vivado_dirs=$(printf '%s\n' "$sorted_candidates"  \
        | cut -f2- | xargs echo)

    if [ "$XILINX_VIVADO" != "$all_vivado_dirs" ]
    then
        warning "multiple Xilinx Vivado installations found:"  \
                "'$all_vivado_dirs'."                          \
                "Using '$XILINX_VIVADO'"

        info "XILINX_VIVADO=$XILINX_VIVADO"
        info "PATH=$PATH"
    fi
}

#-----------------------------------------------------------------------------

setup_run_directory_for_fpga_synthesis_xilinx ()
{
    dir="$1"
    main_src_dir="$2"

    cat "$board_dir/$fpga_board/board_specific.tcl"      \
        "$script_dir/fpga/xilinx_vivado_synthesize.tcl"  \
        > "$dir/fpga_project_synthesize.tcl"

    cat "$board_dir/$fpga_board/board_specific.tcl"      \
        "$script_dir/fpga/xilinx_vivado_configure.tcl"  \
        > "$dir/fpga_project_configure.tcl"
}

#-----------------------------------------------------------------------------

synthesize_for_fpga_xilinx ()
{
    is_command_available_or_error vivado " from Xilinx package"

    if ! vivado -mode batch -source fpga_project_synthesize.tcl 2>&1 | tee -a "$log"
    then
        grep -i -A 5 error "$log" 2>&1
        error "synthesis failed"
    fi
}

#-----------------------------------------------------------------------------

configure_fpga_xilinx ()
{
    is_command_available_or_error vivado " from Xilinx package"

    [ -f fpga_project_configure.tcl ] \
        || error "cannot find a configuration script, most likely synthesis step was not run"

    if ! vivado -mode batch -source fpga_project_configure.tcl 2>&1 | tee -a "$log"
    then
        grep -i -A 5 error "$log" 2>&1
        error "configuration failed"
    fi
}

#-----------------------------------------------------------------------------

run_fpga_synthesis_gui_xilinx ()
{
    is_command_available_or_error vivado " from Xilinx package"

    if   [    -f ./gui_prj/board_specific_top.xpr ] ; then
          vivado ./gui_prj/board_specific_top.xpr &
    elif [    -f post_route.dcp ] ; then
          vivado post_route.dcp &
    elif [    -f post_place.dcp ] ; then
          vivado post_place.dcp &
    elif [    -f post_synth.dcp ] ; then
          vivado post_synth.dcp &
    else
          setup_run_directory_for_fpga_synthesis
          vivado &
    fi
}
