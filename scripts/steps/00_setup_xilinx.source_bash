expected_source_script=00_setup.source_bash

if [ -z "$BASH_SOURCE" ]
then
    printf "script \"%s\" should be sourced from \"%s\"\n"  \
        "$0" "$expected_source_script" 1>&2

    exit 1
fi

this_script=$(basename "${BASH_SOURCE[0]}")
source_script=$(basename "${BASH_SOURCE[1]}")

if [ -z "$source_script" ]
then
    printf "script \"%s\" should be sourced from  \"%s\"\n"  \
        "$this_script" "$expected_source_script" 1>&2

    return 1
fi

if [ "$source_script" != $expected_source_script ]
then
    printf "script \"%s\" should be sourced from  \"%s\", not \"%s\"\n"  \
        "$this_script" "$expected_source_script" "$source_script" 1>&2

    exit 1
fi

#-----------------------------------------------------------------------------

# Sets sort_to_run and sort_options in the caller.

xilinx_sort_discovery ()
{
    local sort_candidate sort_probe

    sort_to_run=sort
    sort_options=()

    # Prefer the Unix utility over Windows sort.exe on PATH.

    for sort_candidate in /usr/bin/sort /bin/sort sort
    do
        if sort_probe=$(printf '2026.10\tb\n2026.2\ta\n' |
            LC_ALL=C "$sort_candidate" -t $'\t' -k1,1V -k2,2 2>/dev/null)
        then
            if [ "$sort_probe" = $'2026.2\ta\n2026.10\tb' ]
            then
                sort_to_run=$sort_candidate
                sort_options=(-t $'\t' -k1,1V -k2,2)
                return
            fi
        fi
    done

    warning "no Unix sort with version sorting support found."          \
            "Using sort from PATH without options (Windows fallback)."  \
            "Alphabetical sorting may select an older Vivado version;"  \
            "set XILINX_VIVADO to select a specific installation."
}

#-----------------------------------------------------------------------------

# Supported installation layouts:
#   <parent>/<vendor>/Vivado/<version>/bin
#   <parent>/<vendor>/<version>/Vivado/bin
#
# Arguments: parent directory, then vendor names. Prints version/path records.

xilinx_collect_vivado_candidates ()
{
    local parent="$1"
    local vendor candidate version
    shift

    for vendor in "$@"
    do
        # Globs retain support for symlinked version directories.
        # Only names beginning with a digit are treated as versions.

        for candidate in "$parent/$vendor/Vivado/"[0-9]*
        do
            [ -d "$candidate/bin" ] || continue

            # ##*/ strips the directory prefix, like basename for this path.
            version=${candidate##*/}

            printf '%s\t%s\n' "$version" "$candidate"
        done

        for candidate in "$parent/$vendor/"[0-9]*/Vivado
        do
            [ -d "$candidate/bin" ] || continue

            # %/Vivado removes the trailing /Vivado suffix from the path.
            version=${candidate%/Vivado}

            # ##*/ strips the directory prefix, like basename for this path.
            version=${version##*/}

            printf '%s\t%s\n' "$version" "$candidate"
        done
    done
}

#-----------------------------------------------------------------------------

xilinx_setup_vivado ()
{
       [ "$OSTYPE" = "linux-gnu" ]  \
    || [ "$OSTYPE" = "cygwin"    ]  \
    || [ "$OSTYPE" = "msys"      ]  \
    || return

    #-------------------------------------------------------------------------

    local parent latest_version_dir
    local candidates sorted_candidates candidate_record candidate_path
    local candidate_paths parent_paths
    local sort_to_run
    local -a sort_options
    local -a search_parents
    local -a vendor_dirs=(Xilinx AMD AMDDesignTools)

    if [ -n "${XILINX_VIVADO-}" ]
    then
        if [ -d "$XILINX_VIVADO/bin" ]
        then
            export PATH="${PATH:+$PATH:}$XILINX_VIVADO/bin"
            return
        fi

        warning "XILINX_VIVADO variable is set to '$XILINX_VIVADO',"  \
                "but there is no directory '$XILINX_VIVADO/bin'."     \
                "Trying to find Vivado directory elsewhere."
    fi

    if is_command_available vivado
    then
        return  # Already set up
    fi

    # Explicit parent first, then the platform's default installation parents.
    search_parents=()

    if [ -n "${XILINX_HOME-}" ]
    then
        search_parents+=("$XILINX_HOME")
    fi

    if [ "$OSTYPE" = "linux-gnu" ]
    then
        search_parents+=("$HOME" /opt /tools)

    elif  [ "$OSTYPE" = "cygwin" ]  \
       || [ "$OSTYPE" = "msys"   ]
    then
        search_parents+=(/c /d /e)
    else
        error "this script does not support your OS / platform '$OSTYPE'"
    fi

    for parent in "${search_parents[@]}"
    do
        candidates=$(xilinx_collect_vivado_candidates "$parent" "${vendor_dirs[@]}")

        if [ -n "$candidates" ]
        then
            xilinx_sort_discovery

            # Compare versions within this parent, then paths in C locale.
            # The alphabetically last path wins an equal-version tie.

            if ! sorted_candidates=$(printf '%s\n' "$candidates" |
                LC_ALL=C "$sort_to_run" "${sort_options[@]}")
            then
                error "failed to sort Vivado versions using '$sort_to_run'."
            fi

            # // replaces every match; $'\r' is CR, removed to normalize CRLF.
            sorted_candidates=${sorted_candidates//$'\r'/}

            # ## removes the longest prefix through a newline, leaving the last row.
            latest_version_dir=${sorted_candidates##*$'\n'}

            # # removes the shortest prefix through a tab, leaving the path.
            latest_version_dir=${latest_version_dir#*$'\t'}

            export XILINX_VIVADO="$latest_version_dir"
            export PATH="${PATH:+$PATH:}$XILINX_VIVADO/bin"

            if [[ "$sorted_candidates" == *$'\n'* ]]
            then
                candidate_paths=

                while IFS= read -r candidate_record
                do
                    # # removes the shortest prefix through a tab: the version field.
                    candidate_path=${candidate_record#*$'\t'}

                    # :+ adds a comma only to a nonempty list; += appends the quoted path.
                    candidate_paths+="${candidate_paths:+, }'$candidate_path'"
                done <<< "$sorted_candidates"

                warning "multiple Vivado installations found: $candidate_paths."  \
                        "Using '$XILINX_VIVADO'."

                info "XILINX_VIVADO=$XILINX_VIVADO"
                info "PATH=$PATH"
            fi

            return
        fi

        if [ -n "${XILINX_HOME-}" ] && [ "$parent" = "$XILINX_HOME" ]
        then
            warning "no Vivado installation found under XILINX_HOME='$XILINX_HOME'."  \
                    "Trying the default installation parents."
        fi
    done

    parent_paths=

    for parent in "${search_parents[@]}"
    do
        # :+ adds a comma only to a nonempty list; += appends the quoted parent.
        parent_paths+="${parent_paths:+, }'$parent'"
    done

    error "cannot find Vivado under: $parent_paths."                        \
          "Expected <parent>/<vendor>/Vivado/<version>/bin or"              \
          "<parent>/<vendor>/<version>/Vivado/bin,"                         \
          "where <vendor> is one of: ${vendor_dirs[*]}."                    \
          "Set XILINX_HOME to <parent>, or XILINX_VIVADO to the directory"  \
          "containing bin for a specific Vivado installation."
}

#-----------------------------------------------------------------------------

# The Vivado scripts read the sources and the constraints from
# boards/<fpga_board>, taking fpga_board from board_specific.tcl. A board
# directory copied from another one and still naming the original there
# would silently build the original's sources and constraints instead.

xilinx_check_board_specific_tcl ()
{
    local tcl="$board_dir/$fpga_board/board_specific.tcl"
    local tcl_fpga_board

    # sed -E captures <name> from a "set fpga_board <name>" line. The name
    # stops at white space, which also leaves out the CR at the end of a
    # line in a file checked out with Windows line endings. tail -n 1 keeps
    # the last such line, the one that wins in Tcl.

    tcl_fpga_board=$(sed -nE 's/^[[:space:]]*set[[:space:]]+fpga_board[[:space:]]+([^[:space:]]+).*/\1/p' "$tcl" | tail -n 1)

    if [ "$tcl_fpga_board" != "$fpga_board" ]
    then
        error "\"$tcl\" sets fpga_board to \"$tcl_fpga_board\""  \
              "instead of \"$fpga_board\", so Vivado would read"    \
              "the sources and constraints of another board."       \
              "Change that line to: set fpga_board $fpga_board"
    fi
}

#-----------------------------------------------------------------------------

setup_run_directory_for_fpga_synthesis_xilinx ()
{
    dir="$1"
    main_src_dir="$2"

    xilinx_check_board_specific_tcl

    cat "$board_dir/$fpga_board/board_specific.tcl"      \
        "$script_dir/fpga/xilinx_vivado_synthesize.tcl"  \
        > "$dir/fpga_project_synthesize.tcl"

    cat "$board_dir/$fpga_board/board_specific.tcl"      \
        "$script_dir/fpga/xilinx_vivado_configure.tcl"   \
        > "$dir/fpga_project_configure.tcl"
}

#-----------------------------------------------------------------------------

synthesize_for_fpga_xilinx ()
{
    is_command_available_or_error vivado " from Xilinx package"

    if ! vivado -mode batch -source fpga_project_synthesize.tcl 2>&1 | tee -a "$log"
    then
        grep -i -A 5 error "$log" 2>&1
        error "synthesis failed"
    fi
}

#-----------------------------------------------------------------------------

configure_fpga_xilinx ()
{
    is_command_available_or_error vivado " from Xilinx package"

    [ -f fpga_project_configure.tcl ] \
        || error "cannot find a configuration script, most likely synthesis step was not run"

    if ! vivado -mode batch -source fpga_project_configure.tcl 2>&1 | tee -a "$log"
    then
        grep -i -A 5 error "$log" 2>&1
        error "configuration failed"
    fi
}

#-----------------------------------------------------------------------------

run_fpga_synthesis_gui_xilinx ()
{
    is_command_available_or_error vivado " from Xilinx package"

    if   [    -f ./gui_prj/board_specific_top.xpr ] ; then
          vivado ./gui_prj/board_specific_top.xpr &
    elif [    -f post_route.dcp ] ; then
          vivado post_route.dcp &
    elif [    -f post_place.dcp ] ; then
          vivado post_place.dcp &
    elif [    -f post_synth.dcp ] ; then
          vivado post_synth.dcp &
    else
          setup_run_directory_for_fpga_synthesis
          vivado &
    fi
}
