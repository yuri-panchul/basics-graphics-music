#
#   Tool setup:
#
#   Intel FPGA Quartus and Questa, licensed by Intel from Siemens EDA
#   Gowin IDE
#   Open Lane
#   Icarus Verilog
#
#-----------------------------------------------------------------------------

source "$script_dir/steps/00_setup_altera.source_bash"
source "$script_dir/steps/00_setup_gowin.source_bash"
source "$script_dir/steps/00_setup_efinity.source_bash"
source "$script_dir/steps/00_setup_xilinx.source_bash"
source "$script_dir/steps/00_setup_libre_lane.source_bash"
source "$script_dir/steps/00_setup_icarus.source_bash"
source "$script_dir/steps/00_setup_yosys.source_bash"
source "$script_dir/steps/00_setup_rars.source_bash"
source "$script_dir/steps/00_setup_riscv.source_bash"
source "$script_dir/steps/00_setup_terminal.source_bash"

#-----------------------------------------------------------------------------
#
#   Two-level FPGA board menu
#
#-----------------------------------------------------------------------------

# The suffixes that mark a configuration of a board rather than a different
# board. The first level of the menu lists the board names with these
# suffixes removed, the second level lists the configurations of the board
# chosen on the first level.
#
# The split is based on the suffixes alone and does not look into
# board_specific.qsf, .xdc, .lpf, .pcf or .cst files. Such a check would be
# unreliable anyway: configurations of the same board comment out different
# pins, and some Gowin boards have separate configurations for Gowin EDA and
# for Yosys.
#
# fpga_board_base tries all the combinations of the suffixes below, so a
# component such as _pmod or _no_hdmi does not need a combined entry of its
# own. Keep the list sorted to make it easy to compare with the directory
# names in "boards".

fpga_board_config_suffixes="
    _50mhz
    _alt
    _bare
    _bright
    _dvi_12b
    _dvi_24b
    _hackathon
    _hdmi
    _hdmi_no_ip_tm1638
    _hdmi_no_tm1638
    _hdmi_tm1638
    _hub75e_led_matrix
    _lcd_480_272
    _lcd_800_480
    _lcd_ml6485
    _no_dvi
    _no_hdmi
    _no_tm1638
    _no_tm1638_yosys
    _pmod
    _pmod_hdmi
    _pmod_mic3
    _pmod_vga
    _quartus_13_1_or_older
    _tm1638
    _tm1638_sd
    _tm1638_yosys
    _vga666
    _vga_pmod
    _virtual_switches
    _wo_dig_0
    _yosys
"

#-----------------------------------------------------------------------------

# The board name that remains after removing a sequence of the suffixes
# above: the shortest such name, searching all the ways to split the tail.
#
# Taking the longest matching suffix at each step would not work, because the
# suffixes overlap. For example, tang_primer_20k_dock_no_hdmi_no_tm1638 ends
# with the listed suffix _hdmi_no_tm1638, which leaves
# tang_primer_20k_dock_no, while the correct split is _no_hdmi followed by
# _no_tm1638, which leaves tang_primer_20k_dock.
#
# The result is returned in a global variable rather than printed, to avoid
# a subshell for every board of the menu.

fpga_board_base_result=

fpga_board_base ()
{
    local name="$1"
    local suffix stripped candidate best="$1"

    for suffix in $fpga_board_config_suffixes
    do
        case "$name" in
            *"$suffix")
                # ${name%$suffix} - $name without the matched suffix

                stripped="${name%$suffix}"

                if [ -n "$stripped" ]
                then
                    fpga_board_base "$stripped"
                    candidate=$fpga_board_base_result

                    if [ ${#candidate} -lt ${#best} ]
                    then
                        best=$candidate
                    fi
                fi
            ;;
        esac
    done

    fpga_board_base_result=$best
}

#-----------------------------------------------------------------------------

# Asks the user for a board and sets the global $fpga_board, or exits if the
# user chooses "exit". The boards to choose from are in
# $available_fpga_boards.

select_fpga_board ()
{
    local i_fpga_board board base label pair n single unique_bases
    local chosen_base chosen_config
    local pairs level1_labels level1_bases level2_labels configs

    # "<board> <base>" for every available board, computed once

    pairs=()

    for i_fpga_board in $available_fpga_boards
    do
        fpga_board_base "$i_fpga_board"
        pairs[${#pairs[@]}]="$i_fpga_board $fpga_board_base_result"
    done

    if [ ${#pairs[@]} = 0 ]
    then
        error "found no FPGA board directories in \"$board_dir\""
    fi

    # The first level of the menu: the unique board names, sorted. A board
    # with a single configuration is listed under the name of that
    # configuration, so that choosing such a board does not open a second
    # menu with one item in it.

    # ${pair#* } - the part after the first space: the base name

    unique_bases=$(
        for pair in "${pairs[@]}"
        do
            printf "%s\n" "${pair#* }"
        done | sort -u
    )

    level1_bases=()
    level1_labels=()

    for base in $unique_bases
    do
        n=0
        single=

        for pair in "${pairs[@]}"
        do
            if [ "${pair#* }" == "$base" ]
            then
                n=$(( n + 1 ))

                # ${pair%% *} - the part before the first space: the board

                single=${pair%% *}
            fi
        done

        level1_bases[${#level1_bases[@]}]=$base

        if [ $n = 1 ]
        then
            level1_labels[${#level1_labels[@]}]=$single
        else
            level1_labels[${#level1_labels[@]}]="$base ($n configurations)"
        fi
    done

    while true
    do
        info "${current_board_message}Please select an FPGA board amoung the following supported:"
        PS3="Your choice (a number): "

        chosen_base=

        select label in "${level1_labels[@]}" exit
        do
            if [ -z "$label" ]
            then
                info "Invalid FPGA board choice, please choose one of the listed numbers again"
                continue
            fi

            # $label is not empty, so $REPLY is the number of a menu item.
            # Comparing the numbers rather than the labels keeps the menu
            # working even for a board directory named "exit".

            if [ $REPLY -gt ${#level1_labels[@]} ]
            then
                info "a new FPGA board is not selected, please run the script again"
                exit 0
            fi

            # The items are numbered from 1, so $REPLY-1 is the array index

            chosen_base=${level1_bases[$(( REPLY - 1 ))]}
            break
        done

        if [ -z "$chosen_base" ]
        then
            # The input ended: "select" exited its loop without a choice

            info "a new FPGA board is not selected, please run the script again"
            exit 0
        fi

        # The configurations of the chosen board, in the same order as in
        # $available_fpga_boards

        configs=()

        for pair in "${pairs[@]}"
        do
            [ "${pair#* }" == "$chosen_base" ] && configs[${#configs[@]}]=${pair%% *}
        done

        if [ ${#configs[@]} = 1 ]
        then
            fpga_board=${configs[0]}

            info "FPGA board selected: $fpga_board"
            return
        fi

        # The second level of the menu. The configuration without a suffix,
        # if there is one, is listed under the board name itself; the others
        # under the suffix that distinguishes them.

        level2_labels=()

        for board in "${configs[@]}"
        do
            if [ "$board" == "$chosen_base" ]
            then
                level2_labels[${#level2_labels[@]}]=$board
            else
                # ${board#${chosen_base}_} - the board name without the
                # leading board name and the underscore after it

                level2_labels[${#level2_labels[@]}]=${board#${chosen_base}_}
            fi
        done

        info "Please select a configuration of the board $chosen_base:"
        PS3="Your choice (a number): "

        chosen_config=

        select label in "${level2_labels[@]}" back exit
        do
            if [ -z "$label" ]
            then
                info "Invalid configuration choice, please choose one of the listed numbers again"
                continue
            fi

            # The two items after the configurations are "back" and "exit"

            if [ $REPLY -gt $(( ${#level2_labels[@]} + 1 )) ]
            then
                info "a new FPGA board is not selected, please run the script again"
                exit 0
            fi

            if [ $REPLY == $(( ${#level2_labels[@]} + 1 )) ]
            then
                break
            fi

            chosen_config=${configs[$(( REPLY - 1 ))]}
            break
        done

        if [ -n "$chosen_config" ]
        then
            fpga_board=$chosen_config

            info "FPGA board selected: $fpga_board"
            return
        fi

        # "back" or the end of the input: ask for the board again
    done
}

#-----------------------------------------------------------------------------
#
#   FPGA board setup
#
#-----------------------------------------------------------------------------

create_fpga_board_select_file()
{
    > "$select_file"

    for i_fpga_board in $available_fpga_boards
    do
        comment="# "
        [ $i_fpga_board == $fpga_board ] && comment=""
        printf "$comment%s\n" "$i_fpga_board" >> "$select_file"
    done

    info "Created an FPGA board selection file: \"$select_file\""
}

#-----------------------------------------------------------------------------

setup_run_directory_for_fpga_synthesis()
{
    dir="${1:-.}"
    parent_dir=$(readlink -f "$dir/..")

    rm -rf "$dir"/*

    case $fpga_toolchain in
    quartus)
        setup_run_directory_for_fpga_synthesis_quartus "$dir" "$parent_dir"
        ;;
    efinity)
        setup_run_directory_for_fpga_synthesis_efinity "$dir" "$parent_dir"
        ;;
    gowin)
        setup_run_directory_for_fpga_synthesis_gowin   "$dir" "$parent_dir"
        ;;
    xilinx)
        setup_run_directory_for_fpga_synthesis_xilinx  "$dir" "$parent_dir"
        ;;
    yosys)
        setup_run_directory_for_fpga_synthesis_yosys  "$dir" "$parent_dir"
        ;;
    *)
        error "Unsupported FPGA synthesis toolchain: $fpga_toolchain." \
              " Currently supported: quartus, xilinx, gowin, yosys."
        ;;
    esac
}

#-----------------------------------------------------------------------------

create_new_run_directories_for_fpga_synthesis()
{
    # TODO - extend this to book directory as well

    $find_to_run "$lab_dir" -name '*synthesize_for_fpga.bash' \
        | while read file
    do
        dir=$(readlink -f "$(dirname "$file")/run")
        info "Setting up: \"$dir\""
        mkdir -p "$dir"
        setup_run_directory_for_fpga_synthesis $dir
    done
}

#-----------------------------------------------------------------------------

update_fpga_toolchain_var ()
{
    case $fpga_board in

        # Yosys should be the first because of * later

        *_yosys )

            fpga_toolchain=yosys
        ;;

        dk_dev_3c120n                        | \
        marsohod_mcy112                      | \
        marsohod_mcy316                      | \
        de0                                  | \
        de1                                  | \
        de2                                  | \
        omdazz_epm570_quartus_13_1_or_older  )

            fpga_toolchain=quartus
        ;;

        alinx_ax301                      | \
        alinx_ax4010*                    | \
        c5gx*                            | \
        de0_cv                           | \
        de0_nano*                        | \
        de0_nano_soc*                    | \
        de1_soc                          | \
        de2_115                          | \
        de10_lite*                       | \
        de10_nano*                       | \
        de23_lite                        | \
        emooc_cc                         | \
        omdazz*                          | \
        piswords6                        | \
        qmtech_c4_starter                | \
        rzrd*                            | \
        saylinx*                         | \
        step_max10                       | \
        terasic_sockit                   | \
        zeowaa*                          )

            fpga_toolchain=quartus
        ;;

        runber                           | \
        marsohod3gw2*                    | \
        tang_*                           | \
        orangepi*                        )

            fpga_toolchain=gowin
        ;;

        trion_t20                        | \
        fireant                          )

            fpga_toolchain=efinity
        ;;

        a7_lite*                         | \
        alinx_ax7035b*                   | \
        arty_a7*                         | \
        arty_s7                          | \
        basys3                           | \
        cmod_a7                          | \
        cmod_s7                          | \
        eclypse_z7                       | \
        nexys4                           | \
        nexys4_ddr                       | \
        nexys_a7*                        | \
        qmtech_kintex_7                  | \
        zybo_z7                          )

            fpga_toolchain=xilinx
        ;;

        *)
            fpga_toolchain=none
        ;;
    esac
}

#-----------------------------------------------------------------------------

fpga_board_setup ()
{
    fpga_toolchain=none

    if ! [[ $script =~ fpga ]] ; then
        return
    fi

    #-------------------------------------------------------------------------

    hackathon_top=../hackathon_top.sv

    if [ -f "$hackathon_top" ]
    then
        fpga_board=$(grep -o '^// Board configuration: [[:alnum:]_]*$' "$hackathon_top" \
            | sed 's|// Board configuration: ||' || true)

        if [ -n "$fpga_board" ]
        then
            update_fpga_toolchain_var
            return
        fi
    fi

    #-------------------------------------------------------------------------

    select_file="$package_dir/fpga_board_selection"

    current_board_message=

    if [ -f "$select_file" ]
    then
        # Consider making it more simple
        # fpga_board=$(grep -m 1 -o '^[[:alnum:]_]*$' "$select_file" || true)

        fpga_board=$(grep -o '^[^#/-]*' "$select_file" | grep -m 1 -o '^[[:alnum:]_]*' || true)
        select_file_contents=$(cat "$select_file")

        if [ -z "$fpga_board" ] ; then
            offer_to_create_a_new_fpga_board_select_file=1
        elif [ $offer_to_create_a_new_fpga_board_select_file = 1 ] ; then
            current_board_message="The currently selected FPGA board: $fpga_board. "
        fi
    fi

    #-------------------------------------------------------------------------

    # TODO: Remove else after testing on Linux and Windows

    if [[ "$OSTYPE" = "darwin"*   ]] ; then
      available_fpga_boards=$($find_to_run "$board_dir" -mindepth 1 -maxdepth 1 -type d | xargs -I % -L 1 basename '%' | sort | tr "\r\n" " ")
    else
      available_fpga_boards=$($find_to_run "$board_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | tr "\r\n" " ")
    fi

    if    ! [ -f "$select_file" ]  \
       ||   [ $offer_to_create_a_new_fpga_board_select_file = 1 ]
    then
        select_fpga_board
        create_fpga_board_select_file

        if [ $offer_to_create_all_run_dirs = 1 ]
        then
            read -n 1 -r -p "Would you like to create the new run directories for the synthesis of all labs in the package, based on your FPGA board selection? We recommend to do this if you plan to work with synthesis GUI rather than with the synthesis scripts. [y/n] "
            printf "\n"

            if [[ "$REPLY" =~ ^[Yy]$ ]]; then
                printf "\n"

                update_fpga_toolchain_var
                create_new_run_directories_for_fpga_synthesis
            fi
        fi
    fi

    if ! [[ " $available_fpga_boards " =~ " $fpga_board " ]] ; then
        # This error may happen if people mess with the selection file

        error "The selected FPGA board $fpga_board"  \
              "is not one of the available boards: $available_fpga_boards"
    fi

    #-------------------------------------------------------------------------

    update_fpga_toolchain_var
}

#-----------------------------------------------------------------------------
#
#   Calling routines
#
#-----------------------------------------------------------------------------

fpga_board_setup

# fpga_toolchain=quartus

case $fpga_toolchain in
    quartus  )
        quartus_setup

        if [ -z "${MGLS_LICENSE_FILE-}" ] ; then
            altera_setup_questa
        fi
    ;;

    gowin   ) gowin_setup_ide     ;;
    efinity ) efinity_setup_ide   ;;
    xilinx  ) xilinx_setup_vivado ;;
    yosys   ) setup_yosys         ;;
esac

librelane_setup
icarus_verilog_setup

if [ -f ../program.s ] ; then
    rars_setup
fi

if ! [ "$script" = "clean_all.bash" ] &&
    find .. -type f -name '*.[chS]' -print -quit | grep -q .
then
    riscv_software_toolchain_setup
fi
