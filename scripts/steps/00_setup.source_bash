set -Eeuo pipefail  # See the meaning in scripts/README.md
# set -x  # Print each command

setup_source_bash_already_run=1

#-----------------------------------------------------------------------------
#
#   Protection against incorrect use
#
#-----------------------------------------------------------------------------

if [ "$(basename "$0")" == bash ]
then
    printf "error: script \"%s\" should be sourced from another script, not from the terminal\n"  \
        "$BASH_SOURCE" 1>&2

    exit 1
fi

if [ "$0" == "$BASH_SOURCE" ]
then
    printf "error: script \"%s\" should be sourced from another script, not used alone\n"  \
        "$0" 1>&2

    exit 1
fi

#-----------------------------------------------------------------------------
#
#   Directory setup
#
#-----------------------------------------------------------------------------

package_dir=$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../..")

bin_dir="$package_dir/bin"
board_dir="$package_dir/boards"
lab_dir="$package_dir/labs"
peripheral_dir="$package_dir/peripherals"
script_dir="$package_dir/scripts"

#-----------------------------------------------------------------------------

adj_path_for_gowin_win ()
{
    if    [ "$OSTYPE" = "cygwin" ]  \
       || [ "$OSTYPE" = "msys"   ]
    then
        echo ${1/#\/[[:alpha:]]\//${1:1:1}:\/}
    else
        echo $1
    fi
}

#-----------------------------------------------------------------------------

script=$(basename "$0")
log="$PWD/log.txt"

if [[ $script =~ check_setup_and_choose_fpga_board ]]
then
    offer_to_create_all_run_dirs=1
else
    offer_to_create_all_run_dirs=0
fi

if [[ $script =~ choose.*fpga_board ]]
then
    offer_to_create_a_new_fpga_board_select_file=1
else
    offer_to_create_a_new_fpga_board_select_file=0

    cd $(dirname "$0")
    mkdir -p run
    cd run

    inside_run_dir=1
fi

lab_name=$(basename "$(readlink -f ..)")

#-----------------------------------------------------------------------------
#
#   General routines
#
#-----------------------------------------------------------------------------

info ()
{
    # The "if" below is a protection against % in arguments
    # which is interpreted as a format by printf.
    #
    # However this method has disadvantage:
    # It prints "\n" for "\n" instead of a newline.

    if [[ "$*" == *"%"* ]] || [[ "$*" == *"\\"* ]] ; then
        printf "\n%s: %s\n" "$script" "$*" 1>&2
    else
        printf "\n%s: $*\n" "$script"      1>&2
    fi
}

#-----------------------------------------------------------------------------

error ()
{
    info error: "$@"

    # Alternative way to check for MacOS:
    # [ ${OSTYPE/[0-9]*/} = "darwin" ]

    if    [  "$OSTYPE" = "linux-gnu" ]  \
       || [  "$OSTYPE" = "cygwin"    ]  \
       || [  "$OSTYPE" = "msys"      ]  \
       || [[ "$OSTYPE" = "darwin"*   ]]
    then
        read -n 1 -p "Press any key "
    fi

    exit 1
}

#-----------------------------------------------------------------------------

warning ()
{
    info warning: "$@"
}

#-----------------------------------------------------------------------------

is_command_available ()
{
    command -v $1 &> /dev/null
}

#-----------------------------------------------------------------------------

is_command_available_or_error ()
{
    is_command_available $1 ||  \
        error "program $1${2-} is not in the path or cannot be run${3-}"
}

#-----------------------------------------------------------------------------

is_command_available_or_error_and_install ()
{
    if [ -n "${2-}" ]; then
        package=$2
    else
        package=$1
    fi

    if [ "$OSTYPE" = "linux-gnu" ]; then
        how_to_install=". To install, run either: \"sudo apt-get install $package\" or \"sudo yum install $package\". If it does not work, google the instructions."
    elif [[ "$OSTYPE" = "darwin"* ]]; then
        how_to_install=". To install, run: \"brew install $package\". If it does not work, google the instructions."
    else
        how_to_install=
    fi

    is_command_available_or_error $1 "" "$how_to_install"
}

#-----------------------------------------------------------------------------
#
#   Platform-specific workarounds
#
#-----------------------------------------------------------------------------

# A workaround for a find problem when running bash under Microsoft Windows

find_to_run=find
true_find=/usr/bin/find

if [ -x $true_find ]
then
    find_to_run=$true_find
fi

if [ "$OSTYPE" = "cygwin" ] || [ "$OSTYPE" = "msys" ] ; then
    exe=".exe"
else
    exe=
fi

#-----------------------------------------------------------------------------

remove_macos_quarantine_attr ()
{
    dir="$1"

    qattr=com.apple.quarantine

    while xattr "$dir" | grep -q $qattr
    do
        warning "Directory '$dir' has '$qattr' attribute."                     \
                "You need to remove the attribute to run the software,"        \
                "using a terminal command:"                                    \
                "xattr -rd $qattr '$dir' ."                                    \
                "If you see a \"Permission denied\" error, try it with sudo:"  \
                "sudo xattr -rd $qattr '$dir'"

        read -n 1 -r -p "Abort, Retry, Ignore? [a/R/i] "
        printf "\n"

        case $REPLY in
        A|a) exit 1 ;;
        I|i) break  ;;
        esac
    done
}

#-----------------------------------------------------------------------------
#
#   Tool setup:
#
#   Intel FPGA Quartus and Questa, licensed by Intel from Siemens EDA
#   Gowin IDE
#   Open Lane
#   Icarus Verilog
#
#-----------------------------------------------------------------------------

source "$script_dir/steps/00_setup_altera.source_bash"
source "$script_dir/steps/00_setup_gowin.source_bash"
source "$script_dir/steps/00_setup_efinity.source_bash"
source "$script_dir/steps/00_setup_xilinx.source_bash"
source "$script_dir/steps/00_setup_libre_lane.source_bash"
source "$script_dir/steps/00_setup_icarus.source_bash"
source "$script_dir/steps/00_setup_yosys.source_bash"
source "$script_dir/steps/00_setup_rars.source_bash"
source "$script_dir/steps/00_setup_riscv.source_bash"
source "$script_dir/steps/00_setup_terminal.source_bash"

#-----------------------------------------------------------------------------
#
#   Two-level FPGA board menu
#
#-----------------------------------------------------------------------------

# The suffixes that mark a configuration of a board rather than a different
# board. The first level of the menu lists the board names with these
# suffixes removed, the second level lists the configurations of the board
# chosen on the first level.
#
# The split is based on the suffixes alone and does not look into
# board_specific.qsf, .xdc, .lpf, .pcf or .cst files. Such a check would be
# unreliable anyway: configurations of the same board comment out different
# pins, and some Gowin boards have separate configurations for Gowin EDA and
# for Yosys.
#
# fpga_board_base tries all the combinations of the suffixes below, so a
# compound such as _no_hdmi needs no entry of its own. Keep the list sorted
# to make it easy to compare with the directory names in "boards".

fpga_board_config_suffixes="
    _50mhz
    _alt
    _bare
    _bright
    _dvi_12b
    _dvi_24b
    _hdmi
    _hdmi_no_ip_tm1638
    _hdmi_no_tm1638
    _hdmi_tm1638
    _hub75e_led_matrix
    _lcd_480_272
    _lcd_800_480
    _lcd_ml6485
    _no_dvi
    _no_hdmi
    _no_tm1638
    _no_tm1638_yosys
    _pmod_hdmi
    _pmod_hub75e_led_matrix
    _pmod_mic3
    _pmod_vga
    _quartus_13_1_or_older
    _tm1638
    _tm1638_sd
    _tm1638_yosys
    _vga666
    _vga_pmod
    _virtual_switches
    _wo_dig_0
    _yosys
"

# Suffixes that name the size of the FPGA rather than a feature of the board.
# The same product is sold in two sizes - Nexys A7-50T and A7-100T, Arty
# A7-35T and A7-100T - differing in the part number in board_specific.tcl, so
# these are configurations of one board rather than two boards.
#
# They are kept apart from the list above because a bare number is a risky
# thing to strip. Do not grow this list without checking that the number
# really names a size of one product and not a different product.

fpga_board_size_suffixes="
    _35
    _50
    _100
"

# Directories under "boards" that are not boards at all and must not appear
# in the menu, in the selection file or in the validity check.

fpga_board_non_boards="
    zzz_postponed_and_retired
"

# Configurations kept only so that older notes and scripts keep working: the
# same part and the same pins as another configuration. For nexys_a7 the
# board_specific.tcl and the .xdc are identical to those of nexys_a7_100, and
# board_specific_top.sv is a single include of it. The second level of the
# menu says so, as "<alias>:<the configuration it stands for>".

fpga_board_legacy_aliases="
    nexys_a7:nexys_a7_100
"

#-----------------------------------------------------------------------------

# The board name that remains after removing a sequence of the suffixes
# above: the shortest such name, searching all the ways to split the tail.
#
# Taking the longest matching suffix at each step would not work, because the
# suffixes overlap. For example, tang_primer_20k_dock_no_hdmi_no_tm1638 ends
# with the listed suffix _hdmi_no_tm1638, which leaves
# tang_primer_20k_dock_no, while the correct split is _no_hdmi followed by
# _no_tm1638, which leaves tang_primer_20k_dock.
#
# The result is returned in a global variable rather than printed, to avoid
# a subshell for every board of the menu.

fpga_board_base_result=

fpga_board_base ()
{
    local name="$1"
    local suffix stripped candidate best="$1"

    for suffix in $fpga_board_config_suffixes $fpga_board_size_suffixes
    do
        case "$name" in
            *"$suffix")
                # ${name%$suffix} - $name without the matched suffix

                stripped="${name%$suffix}"

                if [ -n "$stripped" ]
                then
                    fpga_board_base "$stripped"
                    candidate=$fpga_board_base_result

                    if [ ${#candidate} -lt ${#best} ]
                    then
                        best=$candidate
                    fi
                fi
            ;;
        esac
    done

    fpga_board_base_result=$best
}

#-----------------------------------------------------------------------------

# Echoes its arguments without the directories listed in
# $fpga_board_non_boards, which are not boards and cannot be selected.

fpga_board_drop_non_boards ()
{
    local i_fpga_board non_board result=

    for i_fpga_board in "$@"
    do
        for non_board in $fpga_board_non_boards
        do
            [ "$i_fpga_board" == "$non_board" ] && continue 2
        done

        result="${result:+$result }$i_fpga_board"
    done

    printf "%s" "$result"
}

#-----------------------------------------------------------------------------

# Sets $choice to the number of the menu item the user answered with.
#
# Bash "select" is generous about what it accepts for item eight: "8", "08",
# " 8" and "+8" all work, and "010" means item ten. Arithmetic in Bash,
# however, reads a leading zero as octal, so $(( REPLY - 1 )) turns "010"
# into 7 and fails outright on "08". Keeping only the digits and forcing base
# ten gives the item the user actually picked.
#
# Called only after "select" has returned a non-empty label, which is what
# guarantees there is at least one digit here.

fpga_board_menu_choice ()
{
    # ${REPLY//[!0-9]/} - $REPLY with every non-digit removed
    # 10#               - read the result as decimal rather than as octal

    choice=${REPLY//[!0-9]/}
    choice=$(( 10#0$choice ))
}

#-----------------------------------------------------------------------------

# The configuration that $1 is a legacy alias of, or nothing when $1 is not
# an alias. See fpga_board_legacy_aliases above.

fpga_board_alias_target_result=

fpga_board_alias_target ()
{
    local pair

    fpga_board_alias_target_result=

    for pair in $fpga_board_legacy_aliases
    do
        case "$pair" in
            "$1":*)
                # ${pair#*:} - the part after the colon: the configuration

                fpga_board_alias_target_result=${pair#*:}
                return
            ;;
        esac
    done
}

#-----------------------------------------------------------------------------

# Asks the user for a board and sets the global $fpga_board. Returns non-zero
# without setting it when the user cancels, leaving it to the caller to
# report that and to decide whether to stop. The boards to choose from are in
# $available_fpga_boards.

select_fpga_board ()
{
    local i_fpga_board board base label pair n single
    local chosen_base chosen_config choice
    local pairs level1_labels level1_bases level2_labels configs seen

    # PS3 is the prompt of "select" and REPLY is where it leaves the answer.
    # Both are made local so that the menu leaves no trace in the shell.

    local PS3 REPLY

    # "<board> <base>" for every available board, computed once.
    #
    # Two kinds of directory are left out. A configuration whose name ends in
    # _hackathon is chosen by naming it in hackathon_top.sv, not from this
    # menu; see fpga_board_setup, which reads that file first. A directory
    # listed in $fpga_board_non_boards is not a board at all - the caller
    # drops those as well, and repeating it here keeps this menu correct
    # whatever it is handed.

    pairs=()

    for i_fpga_board in $(fpga_board_drop_non_boards $available_fpga_boards)
    do
        case "$i_fpga_board" in
            *_hackathon)
                continue
            ;;
        esac

        fpga_board_base "$i_fpga_board"
        pairs[${#pairs[@]}]="$i_fpga_board $fpga_board_base_result"
    done

    if [ ${#pairs[@]} = 0 ]
    then
        error "found no FPGA board directories in \"$board_dir\""
    fi

    # The first level of the menu: the unique board names, in the order in
    # which they appear in $available_fpga_boards. A board with a single
    # configuration is listed under the name of that configuration, so that
    # choosing such a board does not open a second menu with one item in it.

    seen=" "
    level1_bases=()
    level1_labels=()

    for pair in "${pairs[@]}"
    do
        # ${pair#* } - the part after the first space: the base name

        base=${pair#* }

        case "$seen" in
            *" $base "*)
                continue
            ;;
        esac

        seen="$seen$base "
        n=0
        single=

        for i_fpga_board in "${pairs[@]}"
        do
            if [ "${i_fpga_board#* }" == "$base" ]
            then
                n=$(( n + 1 ))

                # ${i_fpga_board%% *} - the part before the first space

                single=${i_fpga_board%% *}
            fi
        done

        level1_bases[${#level1_bases[@]}]=$base

        if [ $n = 1 ]
        then
            level1_labels[${#level1_labels[@]}]=$single
        else
            level1_labels[${#level1_labels[@]}]="$base ($n configurations)"
        fi
    done

    while true
    do
        info "${current_board_message}Please select an FPGA board amoung the following supported:"
        PS3="Your choice (a number): "

        chosen_base=

        select label in "${level1_labels[@]}" exit
        do
            if [ -z "$label" ]
            then
                info "Invalid FPGA board choice, please choose one of the listed numbers again"
                continue
            fi

            fpga_board_menu_choice

            if [ $choice -gt ${#level1_labels[@]} ]
            then
                # The item after the boards: "exit"

                return 1
            fi

            # The items are numbered from 1, so $choice-1 is the array index

            chosen_base=${level1_bases[$(( choice - 1 ))]}
            break
        done

        if [ -z "$chosen_base" ]
        then
            # The input ended: "select" exited its loop without a choice

            return 1
        fi

        # The configurations of the chosen board, in the same order as in
        # $available_fpga_boards

        configs=()

        for pair in "${pairs[@]}"
        do
            [ "${pair#* }" == "$chosen_base" ] && configs[${#configs[@]}]=${pair%% *}
        done

        if [ ${#configs[@]} = 1 ]
        then
            fpga_board=${configs[0]}

            info "FPGA board selected: $fpga_board"
            return 0
        fi

        # The second level of the menu. Each configuration is listed under its
        # full directory name, which is also what goes into the selection
        # file, so that what the user picks and what gets written are the same
        # string. A legacy alias says what it stands for.

        level2_labels=()

        for board in "${configs[@]}"
        do
            fpga_board_alias_target "$board"

            if [ -n "$fpga_board_alias_target_result" ]
            then
                label="$board (alias of $fpga_board_alias_target_result)"
            else
                label=$board
            fi

            level2_labels[${#level2_labels[@]}]=$label
        done

        info "Please select a configuration of the board $chosen_base:"
        PS3="Your choice (a number): "

        chosen_config=

        select label in "${level2_labels[@]}" back exit
        do
            if [ -z "$label" ]
            then
                info "Invalid configuration choice, please choose one of the listed numbers again"
                continue
            fi

            fpga_board_menu_choice

            # The two items after the configurations are "back" and "exit"

            if [ $choice -gt $(( ${#level2_labels[@]} + 1 )) ]
            then
                return 1
            fi

            if [ $choice = $(( ${#level2_labels[@]} + 1 )) ]
            then
                break
            fi

            chosen_config=${configs[$(( choice - 1 ))]}
            break
        done

        if [ -n "$chosen_config" ]
        then
            fpga_board=$chosen_config

            info "FPGA board selected: $fpga_board"
            return 0
        fi

        # "back" or the end of the input: ask for the board again
    done
}

#-----------------------------------------------------------------------------
#
#   FPGA board setup
#
#-----------------------------------------------------------------------------

create_fpga_board_select_file()
{
    > "$select_file"

    for i_fpga_board in $available_fpga_boards
    do
        comment="# "
        [ $i_fpga_board == $fpga_board ] && comment=""
        printf "$comment%s\n" "$i_fpga_board" >> "$select_file"
    done

    info "Created an FPGA board selection file: \"$select_file\""
}

#-----------------------------------------------------------------------------

setup_run_directory_for_fpga_synthesis()
{
    dir="${1:-.}"
    parent_dir=$(readlink -f "$dir/..")

    rm -rf "$dir"/*

    case $fpga_toolchain in
    quartus)
        setup_run_directory_for_fpga_synthesis_quartus "$dir" "$parent_dir"
        ;;
    efinity)
        setup_run_directory_for_fpga_synthesis_efinity "$dir" "$parent_dir"
        ;;
    gowin)
        setup_run_directory_for_fpga_synthesis_gowin   "$dir" "$parent_dir"
        ;;
    xilinx)
        setup_run_directory_for_fpga_synthesis_xilinx  "$dir" "$parent_dir"
        ;;
    yosys)
        setup_run_directory_for_fpga_synthesis_yosys  "$dir" "$parent_dir"
        ;;
    *)
        error "Unsupported FPGA synthesis toolchain: $fpga_toolchain." \
              " Currently supported: quartus, xilinx, gowin, yosys."
        ;;
    esac
}

#-----------------------------------------------------------------------------

create_new_run_directories_for_fpga_synthesis()
{
    # TODO - extend this to book directory as well

    $find_to_run "$lab_dir" -name '*synthesize_for_fpga.bash' \
        | while read file
    do
        dir=$(readlink -f "$(dirname "$file")/run")
        info "Setting up: \"$dir\""
        mkdir -p "$dir"
        setup_run_directory_for_fpga_synthesis $dir
    done
}

#-----------------------------------------------------------------------------

update_fpga_toolchain_var ()
{
    case $fpga_board in

        # Yosys should be the first because of * later

        *_yosys )

            fpga_toolchain=yosys
        ;;

        dk_dev_3c120n                        | \
        marsohod_mcy112                      | \
        marsohod_mcy316                      | \
        de0                                  | \
        de1                                  | \
        de2                                  | \
        omdazz_epm570_quartus_13_1_or_older  )

            fpga_toolchain=quartus
        ;;

        alinx_ax301                      | \
        alinx_ax4010*                    | \
        c5gx*                            | \
        de0_cv                           | \
        de0_nano*                        | \
        de0_nano_soc*                    | \
        de1_soc                          | \
        de2_115                          | \
        de10_lite*                       | \
        de10_nano*                       | \
        de23_lite                        | \
        emooc_cc                         | \
        omdazz*                          | \
        piswords6                        | \
        qmtech_c4_starter                | \
        rzrd*                            | \
        saylinx*                         | \
        step_max10                       | \
        terasic_sockit                   | \
        zeowaa*                          )

            fpga_toolchain=quartus
        ;;

        runber                           | \
        marsohod3gw2*                    | \
        tang_*                           | \
        orangepi*                        )

            fpga_toolchain=gowin
        ;;

        trion_t20                        | \
        fireant                          )

            fpga_toolchain=efinity
        ;;

        a7_lite*                         | \
        alinx_ax7035b*                   | \
        arty_a7*                         | \
        arty_s7                          | \
        basys3                           | \
        cmod_a7                          | \
        cmod_s7                          | \
        eclypse_z7                       | \
        nexys4                           | \
        nexys4_ddr                       | \
        nexys_a7*                        | \
        qmtech_kintex_7                  | \
        zybo_z7                          )

            fpga_toolchain=xilinx
        ;;

        *)
            fpga_toolchain=none
        ;;
    esac
}

#-----------------------------------------------------------------------------

fpga_board_setup ()
{
    fpga_toolchain=none

    if ! [[ $script =~ fpga ]] ; then
        return
    fi

    #-------------------------------------------------------------------------

    hackathon_top=../hackathon_top.sv

    if [ -f "$hackathon_top" ]
    then
        fpga_board=$(grep -o '^// Board configuration: [[:alnum:]_]*$' "$hackathon_top" \
            | sed 's|// Board configuration: ||' || true)

        if [ -n "$fpga_board" ]
        then
            update_fpga_toolchain_var
            return
        fi
    fi

    #-------------------------------------------------------------------------

    select_file="$package_dir/fpga_board_selection"

    current_board_message=

    if [ -f "$select_file" ]
    then
        # Consider making it more simple
        # fpga_board=$(grep -m 1 -o '^[[:alnum:]_]*$' "$select_file" || true)

        fpga_board=$(grep -o '^[^#/-]*' "$select_file" | grep -m 1 -o '^[[:alnum:]_]*' || true)
        select_file_contents=$(cat "$select_file")

        if [ -z "$fpga_board" ] ; then
            offer_to_create_a_new_fpga_board_select_file=1
        elif [ $offer_to_create_a_new_fpga_board_select_file = 1 ] ; then
            current_board_message="The currently selected FPGA board: $fpga_board. "
        fi
    fi

    #-------------------------------------------------------------------------

    # TODO: Remove else after testing on Linux and Windows

    # LC_ALL=C keeps the order of the list, and therefore the numbers in the
    # menu, the same on every machine. Under a UTF-8 locale "sort" ignores
    # the underscore at the first comparison level, which swaps de2_115 and
    # de23_lite - so "choose number 26" would mean two different boards.
    #
    # xargs -I implies one command per input line; adding -L 1 as well makes
    # GNU xargs reject the pair and print the literal "%" for every board.

    if [[ "$OSTYPE" = "darwin"*   ]] ; then
      available_fpga_boards=$($find_to_run "$board_dir" -mindepth 1 -maxdepth 1 -type d | xargs -I % basename '%' | LC_ALL=C sort | tr "\r\n" " ")
    else
      available_fpga_boards=$($find_to_run "$board_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | LC_ALL=C sort | tr "\r\n" " ")
    fi

    available_fpga_boards=$(fpga_board_drop_non_boards $available_fpga_boards)

    if    ! [ -f "$select_file" ]  \
       ||   [ $offer_to_create_a_new_fpga_board_select_file = 1 ]
    then
        if ! select_fpga_board
        then
            info "a new FPGA board is not selected, please run the script again"
            exit 0
        fi

        create_fpga_board_select_file

        if [ $offer_to_create_all_run_dirs = 1 ]
        then
            read -n 1 -r -p "Would you like to create the new run directories for the synthesis of all labs in the package, based on your FPGA board selection? We recommend to do this if you plan to work with synthesis GUI rather than with the synthesis scripts. [y/n] "
            printf "\n"

            if [[ "$REPLY" =~ ^[Yy]$ ]]; then
                printf "\n"

                update_fpga_toolchain_var
                create_new_run_directories_for_fpga_synthesis
            fi
        fi
    fi

    if ! [[ " $available_fpga_boards " =~ " $fpga_board " ]] ; then
        # This error may happen if people mess with the selection file

        error "The selected FPGA board $fpga_board"  \
              "is not one of the available boards: $available_fpga_boards"
    fi

    #-------------------------------------------------------------------------

    update_fpga_toolchain_var
}

#-----------------------------------------------------------------------------
#
#   Calling routines
#
#-----------------------------------------------------------------------------

fpga_board_setup

# fpga_toolchain=quartus

case $fpga_toolchain in
    quartus  )
        quartus_setup

        if [ -z "${MGLS_LICENSE_FILE-}" ] ; then
            altera_setup_questa
        fi
    ;;

    gowin   ) gowin_setup_ide     ;;
    efinity ) efinity_setup_ide   ;;
    xilinx  ) xilinx_setup_vivado ;;
    yosys   ) setup_yosys         ;;
esac

librelane_setup
icarus_verilog_setup

if [ -f ../program.s ] ; then
    rars_setup
fi

if ! [ "$script" = "clean_all.bash" ] &&
    find .. -type f -name '*.[chS]' -print -quit | grep -q .
then
    riscv_software_toolchain_setup
fi
