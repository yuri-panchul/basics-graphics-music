expected_source_script=00_setup.source_bash

if [ -z "$BASH_SOURCE" ]
then
    printf "script \"%s\" should be sourced from \"%s\"\n"  \
        "$0" "$expected_source_script" 1>&2

    exit 1
fi

this_script=$(basename "${BASH_SOURCE[0]}")
source_script=$(basename "${BASH_SOURCE[1]}")

if [ -z "$source_script" ]
then
    printf "script \"%s\" should be sourced from  \"%s\"\n"  \
        "$this_script" "$expected_source_script" 1>&2

    return 1
fi

if [ "$source_script" != $expected_source_script ]
then
    printf "script \"%s\" should be sourced from  \"%s\", not \"%s\"\n"  \
        "$this_script" "$expected_source_script" "$source_script" 1>&2

    exit 1
fi

#-----------------------------------------------------------------------------

setup_yosys ()
{
    # OSS-CAD-SUITE most likely has a more recent version of tools,
    # so we should prioritize that over system install
    if [ -d ~/oss-cad-suite ]
    then
        if [[ "$OSTYPE" = "darwin"* ]] ; then
            remove_macos_quarantine_attr ~/oss-cad-suite
        fi

        source ~/oss-cad-suite/environment
    fi

    if [ -d ~/Downloads/oss-cad-suite ]
    then
        if [[ "$OSTYPE" = "darwin"* ]] ; then
            remove_macos_quarantine_attr ~/Downloads/oss-cad-suite
        fi

        source ~/Downloads/oss-cad-suite/environment
    fi

    is_command_available_or_error "yosys" "" ". Either install it from \
        OSS-CAD-SUITE: https://github.com/YosysHQ/oss-cad-suite-build  \
        (recommended) or get it installed manually from repository:    \
        https://github.com/YosysHQ/yosys.git or from                   \
        https://github.com/YosysHQ/oss-cad-suite-build/releases/latest"

    if [[ "$fpga_board" =~ "ice" ]]
    then
        echo "Configuring for Lattice iCE40..."

        is_command_available_or_error "nextpnr-ice40" "" ". Either install it      \
            using OSS-CAD-SUITE: https://github.com/YosysHQ/oss-cad-suite-build or \
            get it installed manually from repository:                             \
            https://github.com/YosysHQ/nextpnr.git. Make sure to configure support \
            for Lattice iCE40 chips which is not enabled by default!" 

        is_command_available_or_error "icepack" "" ". Either install it using   \
            using OSS-CAD-SUITE: https://github.com/YosysHQ/oss-cad-suite-build \
            or repository: https://github.com/YosysHQ/icestorm.git"

        echo "OK"
    fi

    if [[ "$fpga_board" =~ "ecp5" ]]
    then
    echo "Configuring for Lattice ECP5..."

        is_command_available_or_error "nextpnr-ecp5" "" "Either install it         \
            using OSS-CAD-SUITE: https://github.com/YosysHQ/oss-cad-suite-build or \
            get it installed manually from repository:                             \
            https://github.com/YosysHQ/nextpnr.git. Make sure to configure         \
            support for Lattice ECP5 chips which is not enabled by default!"

        is_command_available_or_error "ecppack" "" ". Project Trellis is not   \
            installed in the system. Either install it using OSS-CAD-SUITE:    \
            https://github.com/YosysHQ/oss-cad-suite-build or get it installed \
            manually from repository: https://github.com/YosysHQ/prjtrellis.git"

        echo "OK"
    fi

    if [[ "$fpga_board" =~ "tang" ]]
    then
    echo "Configuring for Gowin chips..."

        is_command_available_or_error "nextpnr-himbaechel" "" ". Either install    \
            it using OSS-CAD-SUITE: https://github.com/YosysHQ/oss-cad-suite-build \
            or get it installed manually from repository:                          \
            https://github.com/YosysHQ/nextpnr.git. Make sure to configure support \
            for Gowin chips which is not enabled by default!"

        is_command_available_or_error "gowin_pack" "" ". Project Apicula is not
            installed. Either install it using OSS-CAD-SUITE:
            https://github.com/YosysHQ/oss-cad-suite-build or get it installed
            manually from repository: https://github.com/YosysHQ/apicula.git"

        echo "OK"
    fi

}

#-------------------------------------------------------------------------

setup_run_directory_for_fpga_synthesis_yosys ()
{
    dir="$1"
    main_src_dir="$2"
    sources=""

    > "$dir/synth.source_bash"

    for verilog_src_dir in       \
        "$main_src_dir"          \
        "$board_dir/$fpga_board" \
        "$peripheral_dir"        \
        "$lab_dir/common"
    do
        # TODO: Check if we really need adj_path_for_gowin_win here

        sources="$sources$($find_to_run $(adj_path_for_gowin_win "$verilog_src_dir")  \
                            -type f \( -name '*.sv' -or -name '*.v' \) -not -name tb.sv | tr '\n' ' ')"
    done

    sources=$(echo "$sources" | sed 's/ / \\\n/g')
    sources=${sources::-2}

    printf "source %s/%s/board_info.source_bash\n\n" $board_dir $fpga_board >> "$dir/synth.source_bash"

    cat << EOF >> "$dir/synth.source_bash"
yosys -p "read_verilog                         \\
-I $(adj_path_for_gowin_win "$main_src_dir")   \\
-I $(adj_path_for_gowin_win "$peripheral_dir") \\
-I $(adj_path_for_gowin_win "$lab_dir")/common \\
-sv $sources;                                  \\
\${SYNTH_CMD} -json netlist.json -top board_specific_top"

EOF

    # ICE40 boards
    if [[ "$fpga_board" =~ "ice" ]]
    then

        cat << EOF >> "$dir/synth.source_bash"
nextpnr-ice40 --\${DEVICE_PART}         \\
              --package \${DEVICE_PACK} \\
              --json netlist.json       \\
              --pcf board_specific.pcf  \\
              --asc pnr.asc \${GUI_OPT}

icepack pnr.asc bitstream.bin
icetime -d \${DEVICE_PART} -mt pnr.asc
EOF

    # ECP5 boards
    elif [[ "$fpga_board" =~ "ecp5" ]]
    then

        printf "TODO"
        exit 0

    # Sipeed (Gowin) boards
    elif [[ "$fpga_board" =~ "tang" ]]
    then

        cat << EOF >> "$dir/synth.source_bash"
nextpnr-himbaechel --json netlist.json             \\
                   --write pnr.pack                \\
                   --device \${DEVICE_PART}        \\
                   --vopt family=\${DEVICE_FAMILY} \\
                   --vopt cst=board_specific.cst   \\
                   --sdc board_specific.sdc \${GUI_OPT}

gowin_pack -d \${DEVICE_PACK} -o bitstream.fs pnr.pack
EOF

    fi

    # Copy pin config file for Lattice iCE40 boards
    if [ -f "$board_dir/$fpga_board/board_specific.pcf" ]
    then
        cat "$board_dir/$fpga_board/board_specific.pcf" > "$dir/board_specific.pcf"
    fi

    # Copy pin config file for Lattice ECP5 boards
    if [ -f "$board_dir/$fpga_board/board_specific.lpf" ]
    then
        cat "$board_dir/$fpga_board/board_specific.lpf" > "$dir/board_specific.lpf"
    fi

    # Copy pin config file for Gowin boards
    if [ -f "$board_dir/$fpga_board/board_specific.cst" ]
    then
        cat "$board_dir/$fpga_board/board_specific.cst" > "$dir/board_specific.cst"
    fi

    # Copy sdc file if exists
    if [ -f "$board_dir/$fpga_board/board_specific.sdc" ]
    then
        cat "$board_dir/$fpga_board/board_specific.sdc" > "$dir/board_specific.sdc"
    fi

}

#-----------------------------------------------------------------------------

synthesize_for_fpga_yosys ()
{
    GUI_OPT=""
    source "synth.source_bash"
}

#-----------------------------------------------------------------------------

configure_fpga_yosys ()
{
    source "$board_dir/$fpga_board/board_info.source_bash"

    is_command_available_or_error openFPGALoader \
        " openFPGALoader utility is not installed in your system. You can get \
        it here: https://trabucayre.github.io/openFPGALoader/guide/install.html"

    #-------------------------------------------------------------------------

    if [ "$OSTYPE" = "linux-gnu" ] && [[ "$fpga_board" =~ "tang" ]]
    then
        rules_dir=/etc/udev/rules.d
        rules_file="$script_dir/fpga/91-sipeed.rules"

        if ! grep -q 'ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6010"' $rules_dir/*
        then
            error "No rules for Sipeed FPGA loader detected in $rules_dir."  \
                  "Please put it there and reboot: sudo cp $rules_file $rules_dir"
        fi

        killall jtagd 2>/dev/null || true
    fi

    #-------------------------------------------------------------------------

    # Bitstream file extention depends on vendor packer and is used by
    # openFPGALoader to determine bitstream file type
    if ! openFPGALoader -b "${BOARD}" bitstream.*
    then
        error "configuration failed"
    fi
}

#-----------------------------------------------------------------------------

run_fpga_synthesis_gui_yosys ()
{
    # Runs nextpnr GUI
    GUI_OPT="--gui"
    source "synth.source_bash"
}
