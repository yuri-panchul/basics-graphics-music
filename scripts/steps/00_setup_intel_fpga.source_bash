expected_source_script=00_setup.source_bash

if [ -z "$BASH_SOURCE" ]
then
    printf "script \"%s\" should be sourced from \"%s\"\n"  \
        "$0" "$expected_source_script" 1>&2

    exit 1
fi

this_script=$(basename "${BASH_SOURCE[0]}")
source_script=$(basename "${BASH_SOURCE[1]}")

if [ -z "$source_script" ]
then
    printf "script \"%s\" should be sourced from  \"%s\"\n"  \
        "$this_script" "$expected_source_script" 1>&2

    return 1
fi

if [ "$source_script" != $expected_source_script ]
then
    printf "script \"%s\" should be sourced from  \"%s\", not \"%s\"\n"  \
        "$this_script" "$expected_source_script" "$source_script" 1>&2

    exit 1
fi

#-----------------------------------------------------------------------------
#
#   Intel FPGA Quartus, formerly from Altera
#
#-----------------------------------------------------------------------------

intel_fpga_info_where_quartus_is_found ()
{
    # info "Found Quartus$1:"
    # info "QUARTUS_ROOTDIR=$QUARTUS_ROOTDIR"
    # info "PATH=$PATH"
    # info "quartus_full_real_path=$quartus_full_real_path"

    printf "%s\n" "$script: Found Quartus$1:"
    printf "%s\n" "QUARTUS_ROOTDIR=$QUARTUS_ROOTDIR"
    printf "%s\n" "PATH=$PATH"
    printf "%s\n" "quartus_full_real_path=$quartus_full_real_path"

                [ -d "$QUARTUS_ROOTDIR" ] ||
    error "directory '$QUARTUS_ROOTDIR' expected"

                [ -d "$QUARTUS_ROOTDIR/$quartus_bin_dir" ]  ||
    error "directory '$QUARTUS_ROOTDIR/$quartus_bin_dir' expected"

                      [ -f "$quartus_full_real_path" ] &&
                      [ -x "$quartus_full_real_path" ] ||
    error "executable file '$quartus_full_real_path' expected"

                      [ -f "$quartus_sh_full_real_path" ] &&
                      [ -x "$quartus_sh_full_real_path" ] ||
    error "executable file '$quartus_sh_full_real_path' expected"

                      [ -f "$quartus_pgm_full_real_path" ] &&
                      [ -x "$quartus_pgm_full_real_path" ] ||
    error "executable file '$quartus_pgm_full_real_path' expected"
}

#-----------------------------------------------------------------------------

# Directory names the Altera and Intel FPGA installers have used over the
# years. The name says nothing about either the age or the edition of what
# is inside it: altera_lite/25.1std holds the Lite edition, and altera/13.1
# holds a Web edition, which is what Lite used to be called.

quartus_vendor_dirs="altera altera_lite altera_std altera_pro"
quartus_vendor_dirs="$quartus_vendor_dirs intelFPGA intelFPGA_lite"
quartus_vendor_dirs="$quartus_vendor_dirs intelFPGA_std intelFPGA_pro"

quartus_newline=$'\n'
quartus_tab=$'\t'

quartus_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/basics-graphics-music"

#-----------------------------------------------------------------------------

# The part this board needs, taken from the board's own project file, so
# that there is no list of board names to keep in step with the boards
# directory.

quartus_part_of_board ()
{
    local qsf="$board_dir/$fpga_board/board_specific.qsf"

    [ -f "$qsf" ] || return 1

    grep -oiE '^[^#]*-name +DEVICE +[^ ]+' "$qsf"  \
        | awk 'NR == 1 { print $NF }'
}

#-----------------------------------------------------------------------------

# Where the executables of an installation live. All three of them have to
# be there, otherwise the directory is an incomplete installation and is
# better skipped than chosen and found wanting later.
#
# Under Microsoft Windows a recent Quartus uses bin64 and an old one uses
# bin, so both are tried rather than deduced from the version.

quartus_bin_dir_of ()
{
    local version_dir="$1"
    local dir

    for dir in bin64 bin
    do
           [ -x "$version_dir/quartus/$dir/quartus$exe"     ]  \
        && [ -x "$version_dir/quartus/$dir/quartus_sh$exe"  ]  \
        && [ -x "$version_dir/quartus/$dir/quartus_pgm$exe" ]  \
        || continue

        printf '%s' "$dir"
        return 0
    done

    return 1
}

#-----------------------------------------------------------------------------

# Every installation under the given parent directories.
#
# The paths are resolved, and one already seen is not added again, because
# the same installation is often reachable two ways at once, such as when
# ALTERA_HOME is set to the home directory.

quartus_find_installations ()
{
    local parent
    local vendor
    local version_dir
    local resolved

    quartus_installations=
    quartus_parents_tried=

    for parent in "$@"
    do
        [ -n "$parent" ] || continue
        [ -d "$parent" ] || continue

        quartus_parents_tried="${quartus_parents_tried:+$quartus_parents_tried or }'$parent'"

        for vendor in $quartus_vendor_dirs
        do
            for version_dir in "$parent/$vendor"/*
            do
                quartus_bin_dir_of "$version_dir" > /dev/null || continue

                resolved=$(readlink -f "$version_dir") || continue

                case "$quartus_newline$quartus_installations$quartus_newline" in
                    *"$quartus_newline$resolved$quartus_newline"*) continue ;;
                esac

                quartus_installations="${quartus_installations:+$quartus_installations$quartus_newline}$resolved"
            done
        done
    done
}

#-----------------------------------------------------------------------------

# A path as the Quartus of this platform wants to see it. Under Cygwin and
# MSYS the Windows executable cannot follow a Unix path.

quartus_native_path ()
{
    if [ "$OSTYPE" = "cygwin" ] || [ "$OSTYPE" = "msys" ]
    then
        cygpath -m "$1"
    else
        printf '%s' "$1"
    fi
}

#-----------------------------------------------------------------------------

# Asks an installation what it is and what it can build, and remembers the
# answer.
#
# Quartus is the only authority here. The directory names do not record the
# edition, and the device data inside an installation is filed under
# internal code names, so MAX 10 for instance appears nowhere as "max10".
# One run answers all of it, because $quartus(version) carries the edition
# name as well as the number.
#
# The run costs between one and five seconds, so the answer is cached and
# keyed by the timestamp of quartus_sh itself.
#
# Sets quartus_probe_version, quartus_probe_edition and
# quartus_probe_cache_file in the caller.

quartus_probe ()
{
    local version_dir="$1"
    local bin_dir
    local quartus_sh
    local stamp
    local cache_file
    local tcl_file
    local header
    local output
    local version_line

    bin_dir=$(quartus_bin_dir_of "$version_dir") || return 1
    quartus_sh="$version_dir/quartus/$bin_dir/quartus_sh$exe"

    stamp=$(date -r "$quartus_sh" +%s 2> /dev/null) || stamp=0

    cache_file="$quartus_cache_dir/install"
    cache_file="$cache_file$(printf '%s' "$version_dir" | tr -c 'A-Za-z0-9._-' '_')"

    if [ -r "$cache_file" ]
    then
        header=$(head -1 "$cache_file")

        if [ "${header%% *}" = "$stamp" ]
        then
            header=${header#* }

            quartus_probe_version=${header%% *}
            quartus_probe_edition=${header##* }
            quartus_probe_cache_file="$cache_file"

            return 0
        fi
    fi

    mkdir -p "$quartus_cache_dir" 2> /dev/null

    tcl_file="$quartus_cache_dir/identify.tcl"

    cat > "$tcl_file" << 'TCL_EOF'
load_package device
puts "BGM_VERSION $quartus(version)"
foreach bgm_item [get_family_list] { puts "BGM_FAMILY $bgm_item" }
foreach bgm_item [get_part_list]   { puts "BGM_PART $bgm_item"   }
TCL_EOF

    # QUARTUS_ROOTDIR is set for this one command, so that a value
    # inherited from the environment cannot make this installation answer
    # questions about a different one

    output=$(QUARTUS_ROOTDIR="$version_dir/quartus" "$quartus_sh"  \
        -t "$(quartus_native_path "$tcl_file")" 2> /dev/null) || return 1

    # No command in these pipelines may exit early: this script runs under
    # "set -o pipefail", where a downstream exit would make a successful
    # lookup look like a failure

    version_line=$(printf '%s\n' "$output"  \
        | sed -n 's/^BGM_VERSION //p' | sed -n '1p')

    [ -n "$version_line" ] || return 1

    # "Version 25.1std.0 Build 1129 10/21/2025 SC Lite Edition" becomes the
    # comparable number 25.1.0 and the edition word "Lite"

    quartus_probe_version=$(printf '%s\n' "$version_line"  \
        | sed -n 's/^Version \([0-9][^ ]*\).*/\1/p' | tr -cd '0-9.')

    quartus_probe_edition=$(printf '%s\n' "$version_line"  \
        | grep -oE 'Web|Lite|Standard|Pro' | sed -n '1p')

    [ -n "$quartus_probe_version" ] || return 1
    [ -n "$quartus_probe_edition" ] || quartus_probe_edition=Unknown

    {
        printf '%s %s %s\n'  \
            "$stamp" "$quartus_probe_version" "$quartus_probe_edition"

        printf '%s\n' "$output" | sed -n 's/^BGM_FAMILY /F /p'
        printf '%s\n' "$output" | sed -n 's/^BGM_PART /P /p'

    } > "$cache_file"

    quartus_probe_cache_file="$cache_file"
}

#-----------------------------------------------------------------------------

# The device family a part belongs to, asked of the installations until one
# of them recognizes the part. The answer belongs to the part and not to
# any installation, so it is cached on its own.
#
# Prints nothing when no installation has heard of the part at all.

quartus_family_of_part ()
{
    local part="$1"
    local cache_file="$quartus_cache_dir/family_$part"
    local tcl_file="$quartus_cache_dir/family.tcl"
    local version_dir
    local bin_dir
    local family

    if [ -r "$cache_file" ]
    then
        cat "$cache_file"
        return 0
    fi

    mkdir -p "$quartus_cache_dir" 2> /dev/null

    cat > "$tcl_file" << 'TCL_EOF'
load_package device
set bgm_raw ""
catch { set bgm_raw [get_part_info -family [lindex $quartus(args) 0]] }

# get_part_info returns a one element list, and the element is the name.
# Comparing the list itself against get_family_list never matches.

puts "BGM_PART_FAMILY [lindex $bgm_raw 0]"
TCL_EOF

    family=

    while IFS= read -r version_dir
    do
        [ -n "$version_dir" ] || continue

        bin_dir=$(quartus_bin_dir_of "$version_dir") || continue

        family=$(QUARTUS_ROOTDIR="$version_dir/quartus"  \
            "$version_dir/quartus/$bin_dir/quartus_sh$exe"  \
            -t "$(quartus_native_path "$tcl_file")" "$part" 2> /dev/null  \
            | sed -n 's/^BGM_PART_FAMILY //p' | sed -n '1p') || family=

        [ -n "$family" ] && break

    done <<< "$quartus_installations"

    printf '%s' "$family" > "$cache_file"
    printf '%s' "$family"
}

#-----------------------------------------------------------------------------

# Can this installation build this exact part?
#
# Two questions, because neither alone is right. An installation lists the
# parts it offers outright, and that is the usual answer. But the list is
# narrower than what the tool can really target: Quartus II 13.1 does not
# list EP3C120F780C6, the part of the dk_dev_3c120n board, and yet compiles
# and fits for it. What 13.1 does have is the Cyclone III family installed,
# and that is the second question.
#
# Asking only for the family of the part would be far too generous: every
# installation here names a family for a Cyclone II part, including the
# ones that cannot build one.

quartus_can_build_part ()
{
    local cache_file="$1"
    local part="$2"
    local family

    grep -q -x -F "P $part" "$cache_file" && return 0

    family=$(quartus_family_of_part "$part")

    [ -n "$family" ] || return 1

    grep -q -x -F "F $family" "$cache_file"
}

#-----------------------------------------------------------------------------

# The installations in order of preference, best first. A free edition wins
# over a paid one even when it is older; after that the newer version wins;
# and Standard comes before Pro only when the versions are equal.
#
# With a part given, only the installations that can build it compete.

quartus_best_installation ()
{
    local part="$1"
    local version_dir
    local records=
    local free_rank
    local edition_rank
    local sorted
    local first

    while IFS= read -r version_dir
    do
        [ -n "$version_dir" ] || continue

        quartus_probe "$version_dir" || continue

        if [ -n "$part" ]
        then
            quartus_can_build_part "$quartus_probe_cache_file" "$part" || continue
        fi

        case $quartus_probe_edition in
            Web | Lite ) free_rank=0 ; edition_rank=0 ;;
            Standard   ) free_rank=1 ; edition_rank=1 ;;
            Pro        ) free_rank=1 ; edition_rank=2 ;;
            *          ) free_rank=2 ; edition_rank=3 ;;
        esac

        records="${records:+$records$quartus_newline}$free_rank$quartus_tab$quartus_probe_version$quartus_tab$edition_rank$quartus_tab$version_dir"

    done <<< "$quartus_installations"

    [ -n "$records" ] || return 1

    sorted=$(printf '%s\n' "$records"  \
        | sort -t "$quartus_tab" -k1,1n -k2,2Vr -k3,3n)

    first=${sorted%%"$quartus_newline"*}

    printf '%s' "$first" | cut -f4-
}

#-----------------------------------------------------------------------------

# What each installation is, for the message shown when none of them can
# build the board

quartus_installation_summary ()
{
    local version_dir
    local summary=

    while IFS= read -r version_dir
    do
        [ -n "$version_dir" ] || continue

        quartus_probe "$version_dir" || continue

        summary="${summary:+$summary, }'$version_dir' is $quartus_probe_edition $quartus_probe_version"

    done <<< "$quartus_installations"

    printf '%s' "$summary"
}

#-----------------------------------------------------------------------------

# The variables the rest of this file and the Questa setup expect

quartus_export_paths ()
{
    export PATH="${PATH:+$PATH:}$QUARTUS_ROOTDIR/$quartus_bin_dir"

    quartus_full_real_path="$QUARTUS_ROOTDIR/$quartus_bin_dir/quartus$exe"
    quartus_sh_full_real_path="$QUARTUS_ROOTDIR/$quartus_bin_dir/quartus_sh$exe"
    quartus_pgm_full_real_path="$QUARTUS_ROOTDIR/$quartus_bin_dir/quartus_pgm$exe"
}

#-----------------------------------------------------------------------------

quartus_warn_cannot_build ()
{
    local part="$1"
    local chosen_by="$2"

    warning "the version of Quartus chosen by $chosen_by,"              \
            "'$choosen_version_dir', cannot build the part '$part'"      \
            "of the board '$fpga_board'. Proceeding, because you asked"   \
            "for this installation, but the synthesis is likely to fail."
}

#-----------------------------------------------------------------------------

# Takes the best installation under one group of parent directories, and
# makes it the one in use. Fails without choosing anything when none of
# them can build the board.
#
# Each group is tried in turn and the first that succeeds ends the search,
# so pointing ALTERA_HOME somewhere is an instruction and not merely a
# hint: a newer Quartus elsewhere does not override it.

quartus_use_best_under ()
{
    local described_as="$1"
    shift

    local candidate

    quartus_find_installations "$@"

    [ -n "$quartus_installations" ] || return 1

    candidate=$(quartus_best_installation "$quartus_target_part") || return 1

    [ -n "$candidate" ] || return 1

    choosen_version_dir="$candidate"

    quartus_bin_dir=$(quartus_bin_dir_of "$choosen_version_dir")  ||
    error "'$choosen_version_dir' has no bin or bin64 with the Quartus executables"

    export QUARTUS_ROOTDIR="$choosen_version_dir/quartus"

    quartus_export_paths

    if quartus_probe "$choosen_version_dir"
    then
        info "using Quartus $quartus_probe_edition"                      \
             "from '$choosen_version_dir' for the board '$fpga_board',"   \
             "found through $described_as"
    fi

    return 0
}

#-----------------------------------------------------------------------------

intel_fpga_setup_quartus ()
{
       [ "$OSTYPE" = "linux-gnu" ]  \
    || [ "$OSTYPE" = "cygwin"    ]  \
    || [ "$OSTYPE" = "msys"      ]  \
    || return

    #-------------------------------------------------------------------------

    # Workarounds for Quartus library problems
    # that are uncovered under RED OS from https://www.red-soft.ru

    if      [ "${inside_run_dir-}" = 1    ]  \
       && ! [ -f /usr/lib64/libcrypt.so.1 ]  \
       &&   [ -f /usr/lib64/libcrypt.so   ]
    then
        ln -sf /usr/lib64/libcrypt.so libcrypt.so.1
        export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$PWD"
    fi

    #-------------------------------------------------------------------------

    local quartus_target_part
    local overridden=0
    local summary
    local found_path
    local found_bin_dir
    local found_root

    quartus_target_part=$(quartus_part_of_board) || quartus_target_part=

    #-------------------------------------------------------------------------

    # QUARTUS_ROOTDIR names one installation and is obeyed as it stands

    if    [ -n "${QUARTUS_ROOTDIR-}"                   ]  \
       && [ -d "$QUARTUS_ROOTDIR"                      ]  \
       && [ $(basename "$QUARTUS_ROOTDIR") = "quartus" ]
    then
        choosen_version_dir=$(dirname "$QUARTUS_ROOTDIR")

        quartus_bin_dir=$(quartus_bin_dir_of "$choosen_version_dir")  ||
        error "directory '$QUARTUS_ROOTDIR' has no bin or bin64"  \
              "with the Quartus executables in it"

        quartus_export_paths

        quartus_installations="$choosen_version_dir"

        if    [ -n "$quartus_target_part" ]  \
           && quartus_probe "$choosen_version_dir"
        then
            quartus_can_build_part  \
                "$quartus_probe_cache_file" "$quartus_target_part"  ||
            quartus_warn_cannot_build "$quartus_target_part" "QUARTUS_ROOTDIR"
        fi

        intel_fpga_info_where_quartus_is_found " using QUARTUS_ROOTDIR"
        return
    fi

    #-------------------------------------------------------------------------

    # Quartus already in the path is a hint rather than an instruction: it
    # is used when it can build the board, and reported and passed over
    # when it cannot, because it is often there by accident

    if is_command_available quartus$exe
    then
        found_path=$(readlink -f "$(command -v quartus$exe)")
        found_bin_dir=$(basename "$(dirname "$found_path")")
        found_root=$(dirname "$(dirname "$found_path")")

        if [ "$(basename "$found_root")" = quartus ]
        then
            choosen_version_dir=$(dirname "$found_root")
            quartus_installations="$choosen_version_dir"

            if    [ -z "$quartus_target_part" ]  \
               || ! quartus_probe "$choosen_version_dir"  \
               || quartus_can_build_part  \
                      "$quartus_probe_cache_file" "$quartus_target_part"
            then
                quartus_bin_dir=$found_bin_dir
                export QUARTUS_ROOTDIR="$found_root"

                quartus_export_paths

                intel_fpga_info_where_quartus_is_found " using PATH"
                return
            fi

            warning "the Quartus in the path, '$choosen_version_dir',"       \
                    "cannot build the part '$quartus_target_part' of the"     \
                    "board '$fpga_board', so it is passed over."              \
                    "Set QUARTUS_ROOTDIR to use it regardless."
        else
            warning "quartus is in the path outside the usual installation directory"
        fi
    fi

    #-------------------------------------------------------------------------

    if    [ -n "${INTEL_FPGA_HOME-}" ]  \
       || [ -n "${ALTERA_HOME-}"     ]  \
       || [ -n "${QUARTUS_HOME-}"    ]
    then
        overridden=1
    fi

    quartus_use_best_under "INTEL_FPGA_HOME" "${INTEL_FPGA_HOME-}" && return
    quartus_use_best_under "ALTERA_HOME"     "${ALTERA_HOME-}"     && return
    quartus_use_best_under "QUARTUS_HOME"    "${QUARTUS_HOME-}"    && return

    if [ "$OSTYPE" = "linux-gnu" ]
    then
        quartus_use_best_under "the standard locations"  \
            "$HOME" /opt /tools && return
    else
        quartus_use_best_under "the standard locations"  \
            /c /d /e && return
    fi

    #-------------------------------------------------------------------------

    # Nothing anywhere can build this board. An installation asked for by
    # an environment variable is used anyway, with a warning; without such
    # a request this is an error.

    if [ "$OSTYPE" = "linux-gnu" ]
    then
        quartus_find_installations  \
            "${INTEL_FPGA_HOME-}" "${ALTERA_HOME-}" "${QUARTUS_HOME-}"  \
            "$HOME" /opt /tools
    else
        quartus_find_installations  \
            "${INTEL_FPGA_HOME-}" "${ALTERA_HOME-}" "${QUARTUS_HOME-}"  \
            /c /d /e
    fi

    [ -n "$quartus_installations" ]  ||
    error "cannot find any installation of Quartus under"                 \
          "$quartus_parents_tried."                                       \
          "A directory named one of: $quartus_vendor_dirs"                \
          "is expected there, with a version directory inside it."        \
          "The location can also be set by the environment variables"     \
          "INTEL_FPGA_HOME, ALTERA_HOME or QUARTUS_HOME, or a particular"  \
          "installation by QUARTUS_ROOTDIR."

    summary=$(quartus_installation_summary)

    if [ $overridden = 1 ]
    then
        quartus_find_installations  \
            "${INTEL_FPGA_HOME-}" "${ALTERA_HOME-}" "${QUARTUS_HOME-}"

        choosen_version_dir=$(quartus_best_installation "")  ||
            choosen_version_dir=

        if [ -n "$choosen_version_dir" ]
        then
            quartus_bin_dir=$(quartus_bin_dir_of "$choosen_version_dir")  ||
            error "'$choosen_version_dir' has no bin or bin64"  \
                  "with the Quartus executables"

            export QUARTUS_ROOTDIR="$choosen_version_dir/quartus"

            quartus_export_paths

            quartus_warn_cannot_build "$quartus_target_part"  \
                "INTEL_FPGA_HOME, ALTERA_HOME or QUARTUS_HOME"

            intel_fpga_info_where_quartus_is_found " using an environment variable"
            return
        fi
    fi

    error "no installed version of Quartus can build the part"            \
          "'$quartus_target_part' of the board '$fpga_board'."             \
          "Found: $summary."                                               \
          "Point QUARTUS_ROOTDIR at an installation to use it regardless,"  \
          "or INTEL_FPGA_HOME, ALTERA_HOME or QUARTUS_HOME at a directory"   \
          "that holds one."
}
#-----------------------------------------------------------------------------
#
#   Intel FPGA version of Questa by Siemens EDA (former Mentor Graphics)
#
#-----------------------------------------------------------------------------

intel_fpga_setup_questa ()
{
       [ "$OSTYPE" = "linux-gnu" ]  \
    || [ "$OSTYPE" = "cygwin"    ]  \
    || [ "$OSTYPE" = "msys"      ]  \
    || return

    if is_command_available vsim$exe
    then
        vsim_command="vsim$exe"
        vcover_command="vcover$exe"

        return  # Already set up
    fi

    [ -n "${choosen_version_dir-}" ] ||
        error "Intel FPGA Quartus was supposed to be setup first. "  \
              "Probably internal error."

    #-------------------------------------------------------------------------

    questa_dir=questa_fse

    if [ "$OSTYPE" = "linux-gnu" ]
    then
        questa_bin_dir=bin
        questa_lib_dir=linux_x86_64

    elif  [ "$OSTYPE" = "cygwin"    ]  \
       || [ "$OSTYPE" = "msys"      ]
    then
        questa_bin_dir=win64
        questa_lib_dir=win64
    else
        error "this script does not support your OS / platform '$OSTYPE'"
    fi

    #-------------------------------------------------------------------------

    default_lm_license_file="$HOME/flexlm/license.dat"

    if [ -f "$default_lm_license_file" ]
    then
        if [ -z "${LM_LICENSE_FILE-}" ] ; then
            export LM_LICENSE_FILE="$default_lm_license_file"
        fi

        if [ -z "${MGLS_LICENSE_FILE-}" ] ; then
            export MGLS_LICENSE_FILE="$default_lm_license_file"
        fi
    fi

    #-------------------------------------------------------------------------

    # Check if Quartus is installed without Questa
    [ -d "$choosen_version_dir/$questa_dir" ] || return 0

    export PATH="${PATH:+$PATH:}$choosen_version_dir/$questa_dir/$questa_bin_dir"
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$choosen_version_dir/$questa_dir/$questa_lib_dir"

    vsim_command="$choosen_version_dir/$questa_dir/$questa_bin_dir/vsim$exe"
    vcover_command="$choosen_version_dir/$questa_dir/$questa_bin_dir/vcover$exe"

    #-------------------------------------------------------------------------

                [ -d "$choosen_version_dir/$questa_dir/$questa_bin_dir" ] ||
    error "directory '$choosen_version_dir/$questa_dir/$questa_bin_dir' expected"

                      [ -f "$vsim_command" ] ||
    error "executable file '$vsim_command' expected"

                      [ -f "$vcover_command" ] ||
    error "executable file '$vcover_command' expected"

    #          [ -x "$vsim_command" ] ||
    # warning "file '$vsim_command' is not executable."  \
    #         "Questa is installed with incorrect permissions?"

    #          [ -x "$vcover_command" ] ||
    # warning "file '$vcover_command' is not executable."  \
    #         "Questa is installed with incorrect permissions?"
}

#-----------------------------------------------------------------------------

questa_script=../questa.tcl
[ "$OSTYPE" = "linux-gnu" ] && [ "${USER:-}" = panchul ] && questa_script=../questa2.tcl
# USER might be not set in Apple Mac

run_questa ()
{
    error_prefix="This example is supposed to be run with Questa simulator. However,"

       [ "$OSTYPE" = "linux-gnu" ]  \
    || [ "$OSTYPE" = "cygwin"    ]  \
    || [ "$OSTYPE" = "msys"      ]  \
    || error "$error_prefix this simulator does not run under OS / platform '$OSTYPE'"

    if [ -z "${LM_LICENSE_FILE-}" ]
    then
        if [ -z "${MGLS_LICENSE_FILE-}" ]
        then
            warning "$error_prefix neither variable LM_LICENSE_FILE"  \
                    "nor MGLS_LICENSE_FILE is set."                   \
                    "Probably script got confused"                    \
                    "with multiple Quartus directories."

        elif ! [ -f "$MGLS_LICENSE_FILE" ]
        then
            warning "$error_prefix your variable LM_LICENSE_FILE is not set"  \
                    "and the default license file '$MGLS_LICENSE_FILE'"       \
                    "does not exist."                                         \
                    "You may need to resolve the licensing issues."
        fi
    fi

    if ! is_command_available "$vsim_command"
    then
        error "$error_prefix '$vsim_command' executable is not available."  \
              "Have you installed the simulator, either"                    \
              "together with Quartus package or separately?"
    fi

    if grep 'add wave' $questa_script ; then
        vsim_options=-gui
    else
        vsim_options=-c
    fi

    "$vsim_command" $vsim_options -do $questa_script 2>&1
    cp transcript "$log"

    if [ -f coverage.ucdb ] ; then
        "$vcover_command" report -details -html coverage.ucdb
    fi
}

#-----------------------------------------------------------------------------
#
#   Intel FPGA boards
#
#-----------------------------------------------------------------------------

setup_run_directory_for_fpga_synthesis_quartus ()
{
    dir="$1"
    main_src_dir="$2"

    #-------------------------------------------------------------------------

    # We need relative paths here because Quartus under Windows
    # does not like /c/... full paths.

    # We don't need quotation marks around relative paths
    # because these particular relative paths
    # are expected to contain only alnums, underscores and slashes.

    rel_main_src_dir=$(realpath   --relative-to="$dir" "$main_src_dir")
    rel_board_dir=$(realpath      --relative-to="$dir" "$board_dir")
    rel_peripheral_dir=$(realpath --relative-to="$dir" "$peripheral_dir")
    rel_lab_dir=$(realpath        --relative-to="$dir" "$lab_dir")

    #-------------------------------------------------------------------------

    > "$dir/fpga_project.qpf"

    cat << EOF > "$dir/fpga_project.qsf"
set_global_assignment -name NUM_PARALLEL_PROCESSORS  4
set_global_assignment -name TOP_LEVEL_ENTITY         board_specific_top
set_global_assignment -name SDC_FILE                 $rel_board_dir/$fpga_board/board_specific.sdc

set_global_assignment -name SEARCH_PATH $rel_main_src_dir
set_global_assignment -name SEARCH_PATH $rel_board_dir/$fpga_board
set_global_assignment -name SEARCH_PATH $rel_peripheral_dir
set_global_assignment -name SEARCH_PATH $rel_lab_dir/common

set_global_assignment -name SEARCH_PATH ../cpu
set_global_assignment -name VERILOG_MACRO "INTEL_VERSION"

EOF

    $find_to_run  \
        "$main_src_dir" "$board_dir/$fpga_board" "$peripheral_dir" "$lab_dir/common"  \
        -type f -name '*.sv' -not -name tb.sv  \
        -printf "set_global_assignment -name SYSTEMVERILOG_FILE %P\n"  \
        >> "$dir/fpga_project.qsf"

    if [ -f "$main_src_dir/extra_project_files.qsf" ] ; then
        cat "$main_src_dir/extra_project_files.qsf" >> "$dir/fpga_project.qsf"
    fi

    cat "$board_dir/$fpga_board/board_specific.qsf" >> "$dir/fpga_project.qsf"

    $find_to_run "$board_dir/$fpga_board"  \
                 -name '*.qsf'             \
               ! -name board_specific.qsf  \
                 -exec cp {} "$dir"        \;
}

#-----------------------------------------------------------------------------
#
#   Synthesis and configuration
#
#-----------------------------------------------------------------------------

synthesize_for_fpga_quartus ()
{
    is_command_available_or_error "$quartus_sh_full_real_path" " from Intel FPGA Quartus Prime package"

    if ! "$quartus_sh_full_real_path" --no_banner --flow compile fpga_project 2>&1 | tee -a "$log"
    then
        grep -i -A 5 error "$log" 2>&1
        error "synthesis failed"
    fi
}

#-----------------------------------------------------------------------------

# Need to put detailed dump to debug MEI situation

configure_fpga_quartus ()
{
    is_command_available_or_error "$quartus_pgm_full_real_path" " from Intel FPGA Quartus Prime package"

    #-------------------------------------------------------------------------

    if [ "$OSTYPE" = "linux-gnu" ]
    then
        rules_dir=/etc/udev/rules.d
        rules_file="$script_dir/fpga/90-intel-fpga.rules"

        # TODO: Proposed change
        # if ! grep -q "USB[- ]Blaster" $rules_dir/*

        if ! grep -q USB-Blaster $rules_dir/*
        then
            error "No rules for USB Blaster detected in $rules_dir."  \
                  "Please put it there and reboot: sudo cp $rules_file $rules_dir"
        fi

        killall jtagd 2>/dev/null || true
    fi

    #-------------------------------------------------------------------------

    "$quartus_pgm_full_real_path" -l &> cable_list

    cable_name_1=$(set +o pipefail; grep "1) " cable_list | sed 's/.*1) //')
    cable_name_2=$(set +o pipefail; grep "2) " cable_list | sed 's/.*2) //')

    if [ -n "$cable_name_1" ]
    then
        if [ -n "$cable_name_2" ]
        then
            warning "more than one cable is connected:" \
                    "$cable_name_1 and $cable_name_2"
        fi

        info "using cable $cable_name_1"

        config_file_1=fpga_project.sof
        config_file_2=fpga_project.pof

        config_file=$config_file_1

        if ! [ -f $config_file ]
        then
            config_file=$config_file_2

            if ! [ -f $config_file ]
            then
                error "Neither $config_file_1 nor $config_file_2" \
                    "config file is available"
            fi
        fi

        # Cyclone V SE/SX/ST is an SOC with an ARM processor.
        # ARM is the first at the jtag and FPGA is the second.
        # Need for a special quartus_pgm call.

        # Get the device name from qsf file

        device_str=$(grep DEVICE "$board_dir/$fpga_board/board_specific.qsf")
        device_name=none

        for word in $device_str
        do
            if [[ $word =~ 5C ]]
            then
                device_name=${word:0:4}
                break
            fi
        done

        # Check the device name

        if [ $fpga_board = de1_soc ] || [ $fpga_board = de10_nano ]
        then
            # TODO: Proposed change
            # "$quartus_pgm_full_real_path" --no_banner -c "$cable_name_1" --mode=jtag -o "P;$config_file@1"

            "$quartus_pgm_full_real_path" --no_banner -c "$cable_name_1" --mode=jtag -o "P;$config_file@2"
        else
            "$quartus_pgm_full_real_path" --no_banner -c "$cable_name_1" --mode=jtag -o "P;$config_file"
        fi
    else
        # TODO: Put check for error in WSL
        # if [ "$OSTYPE" = "linux-gnu" ] && [ -n "${WSL_DISTRO_NAME-}" ]

        error "cannot detect a USB-Blaster cable connected"  \
              "for $fpga_board FPGA board"
    fi

    rm -f cable_list
}

#-----------------------------------------------------------------------------

run_fpga_synthesis_gui_quartus ()
{
    is_command_available_or_error "$quartus_full_real_path" " from Intel FPGA Quartus Prime package"

    setup_run_directory_for_fpga_synthesis

    "$quartus_full_real_path" fpga_project.qpf &
}
