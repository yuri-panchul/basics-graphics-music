expected_source_script=00_setup.source_bash

if [ -z "$BASH_SOURCE" ]
then
    printf "script \"%s\" should be sourced from \"%s\"\n"  \
        "$0" "$expected_source_script" 1>&2

    exit 1
fi

this_script=$(basename "${BASH_SOURCE[0]}")
source_script=$(basename "${BASH_SOURCE[1]}")

if [ -z "$source_script" ]
then
    printf "script \"%s\" should be sourced from  \"%s\"\n"  \
        "$this_script" "$expected_source_script" 1>&2

    return 1
fi

if [ "$source_script" != $expected_source_script ]
then
    printf "script \"%s\" should be sourced from  \"%s\", not \"%s\"\n"  \
        "$this_script" "$expected_source_script" "$source_script" 1>&2

    exit 1
fi

#-----------------------------------------------------------------------------
#
#   Altera Quartus discovery. See scripts/README.md for the selection policy.
#
#-----------------------------------------------------------------------------

# Print a numeric version key. Edition markers are not edition evidence.

quartus_version_key ()
{
    local quartus_value="$1"

    # // removes every std marker, as in the Lite version 25.1std.0.
    quartus_value=${quartus_value//std/}

    # / replaces the first sp marker: 13.0sp1 becomes 13.0.1.
    quartus_value=${quartus_value/sp/.}

    [[ "$quartus_value" =~ ^[0-9]+(\.[0-9]+){1,3}$ ]] || return 1
    printf '%s\n' "$quartus_value"
}

# Return success when the first numeric version is newer than the second.

quartus_version_newer ()
{
    local quartus_index quartus_left_number quartus_right_number
    local -a quartus_left quartus_right
    IFS=. read -r -a quartus_left <<< "$1"
    IFS=. read -r -a quartus_right <<< "$2"

    for quartus_index in 0 1 2 3
    do
        # :- supplies zero for missing components; 10# means decimal.
        quartus_left_number=$((10#${quartus_left[quartus_index]:-0}))

        # Missing components compare as zero on the right side as well.
        quartus_right_number=$((10#${quartus_right[quartus_index]:-0}))

        [ "$quartus_left_number" -gt "$quartus_right_number" ] && return 0
        [ "$quartus_left_number" -lt "$quartus_right_number" ] && return 1
    done

    return 1
}

# Sets quartus_candidate_version and quartus_candidate_edition in the caller.

quartus_read_identity ()
{
    local quartus_root="$1" quartus_bin="$2"
    local quartus_line quartus_version= quartus_edition= quartus_banner quartus_build
    local quartus_version_pattern='Version[[:space:]]+([0-9]+\.[0-9]+(std)?(\.[0-9]+)*)'
    local quartus_build_pattern='Build[[:space:]]+([0-9]+)'

    if [ -r "$quartus_root/version.txt" ]
    then
        while IFS= read -r quartus_line || [ -n "$quartus_line" ]
        do
            # // removes CR characters from Windows CRLF metadata.
            quartus_line=${quartus_line//$'\r'/}

            case "$quartus_line" in
                Version=*)
                    # # removes the first key= prefix, leaving its value.
                    quartus_version=${quartus_line#*=}
                ;;
                Edition=*)
                    # # removes the first key= prefix, leaving its value.
                    quartus_edition=${quartus_line#*=}
                ;;
            esac
        done < "$quartus_root/version.txt"
    fi

    case "$quartus_edition" in
        lite) quartus_candidate_edition=Lite ;;
        web) quartus_candidate_edition=Web ;;
        standard | std) quartus_candidate_edition=Standard ;;
        subscription) quartus_candidate_edition=Subscription ;;
        pro) quartus_candidate_edition=Pro ;;
        *) quartus_candidate_edition= ;;
    esac

    if quartus_candidate_version=$(quartus_version_key "$quartus_version") &&
       [ -n "$quartus_candidate_edition" ]
    then
        return 0
    fi

    # The banner handles old Web/Subscription installations without edition metadata.

    if ! quartus_banner=$(QUARTUS_ROOTDIR="$quartus_root" \
        "$quartus_root/$quartus_bin/quartus_sh$exe" --version 2>&1)
    then
        quartus_rejection="Cannot run quartus_sh --version."
        return 1
    fi

    if [[ "$quartus_banner" =~ $quartus_version_pattern ]]
    then
        quartus_version=${BASH_REMATCH[1]}
    else
        quartus_rejection="Cannot read the Quartus version."
        return 1
    fi

    if [[ "$quartus_banner" =~ $quartus_build_pattern ]]
    then
        quartus_build=${BASH_REMATCH[1]}

        if [[ "$quartus_version" =~ ^[0-9]+\.[0-9]+(std)?$ ]]
        then
            quartus_version+=.0
        fi

        quartus_version+=".$quartus_build"
    fi

    case "$quartus_banner" in
        *"Lite Edition"*) quartus_candidate_edition=Lite ;;
        *"Web Edition"*) quartus_candidate_edition=Web ;;
        *"Standard Edition"*) quartus_candidate_edition=Standard ;;
        *"Subscription Edition"*) quartus_candidate_edition=Subscription ;;
        *"Pro Edition"*) quartus_candidate_edition=Pro ;;
        *)
            quartus_rejection="Cannot identify the Quartus edition."
            return 1
        ;;
    esac

    if ! quartus_candidate_version=$(quartus_version_key "$quartus_version")
    then
        quartus_rejection="Cannot normalize version '$quartus_version'."
        return 1
    fi
}

# Read literal QSF data without executing arbitrary Tcl from the board file.

quartus_read_target ()
{
    local quartus_line
    local quartus_pattern='^[[:space:]]*set_global_assignment[[:space:]]+-name[[:space:]]+DEVICE[[:space:]]+"?([[:alnum:]]+)"?([[:space:]]|$)'
    quartus_target_part=

    while IFS= read -r quartus_line || [ -n "$quartus_line" ]
    do
        if [[ "$quartus_line" =~ $quartus_pattern ]]
        then
            quartus_target_part=${BASH_REMATCH[1]}
        fi
    done < "$board_dir/$fpga_board/board_specific.qsf"

    if [ -z "$quartus_target_part" ]
    then
        error "cannot read a literal DEVICE assignment for board '$fpga_board'."

        return 1
    fi
}

quartus_free_edition ()
{
    [ "$1" = Lite ] || [ "$1" = Web ]
}

# The device database provides the final exact-part check, including old updates.
# Family limits: https://www.altera.com/design/guidance/software/device-support

quartus_family_compatible ()
{
    local quartus_version="$1" quartus_edition="$2" quartus_limit=

    case "$quartus_target_part" in
        EP1C*)
            if quartus_free_edition "$quartus_edition"
            then
                quartus_limit=11.0.1.999999
            else
                quartus_limit=13.0.1.999999
            fi
        ;;
        EP2C*) quartus_limit=13.0.1.999999 ;;
        EP3C*) quartus_limit=13.1.0.999999 ;;
        A3*)
            [ "$quartus_edition" = Pro ] || return 1
            quartus_version_newer 25.1 "$quartus_version" && return 1
        ;;
        10M*)
            quartus_version_newer 14.0 "$quartus_version" && return 1
        ;;
    esac

    case "$quartus_target_part" in
        EP1C* | EP2C* | EP3C* | EP4C* | 5C* | 10M* | EPM*)
            [ "$quartus_edition" = Pro ] && return 1
        ;;
    esac

    if [ "$fpga_board" = omdazz_epm570_quartus_13_1_or_older ]
    then
        quartus_limit=13.1.0.999999
    fi

    if [ -n "$quartus_limit" ] && quartus_version_newer "$quartus_version" "$quartus_limit"
    then
        return 1
    fi

    return 0
}

quartus_warn_install_path ()
{
    local quartus_path="$1"
    local LC_ALL=C
    local quartus_safe_path='^[A-Za-z0-9_./:\\-]+$'

    if ! [[ "$quartus_path" =~ $quartus_safe_path ]]
    then
        warning "Quartus installation path '$quartus_path' contains spaces,"    \
                "non-ASCII text, or special characters unsupported by Altera."  \
                'Examples include ! $ % @ ^ & * < > , quotes and parentheses.'  \
                "Quartus may fail; relocate it to a simple ASCII path."
    fi
}

# Arrays are local to quartus_setup; helpers append without splitting path names.

quartus_collect_parent ()
{
    local quartus_parent="$1" quartus_vendor quartus_root
    [ -n "$quartus_parent" ] || return 0

    if [ "$OSTYPE" = cygwin ] || [ "$OSTYPE" = msys ]
    then
        quartus_parent=$(cygpath -u "$quartus_parent") || return 1
    fi

    for quartus_vendor in altera altera_lite altera_std altera_pro \
        intelFPGA intelFPGA_lite intelFPGA_pro intelFPGA_std
    do
        for quartus_root in "$quartus_parent/$quartus_vendor/"[0-9]*/quartus
        do
            [ -d "$quartus_root" ] || continue
            quartus_candidates+=("$quartus_root")
        done
    done
}

# Prefer Lite/Web; otherwise compare versions before the Standard/Pro tie-break.

quartus_candidate_better ()
{
    [ -n "$quartus_best_root" ] || return 0

    if quartus_free_edition "$quartus_candidate_edition" && ! quartus_free_edition "$quartus_best_edition"
    then
        return 0
    fi

    if ! quartus_free_edition "$quartus_candidate_edition" && quartus_free_edition "$quartus_best_edition"
    then
        return 1
    fi

    quartus_version_newer "$quartus_candidate_version" "$quartus_best_version" && return 0
    quartus_version_newer "$quartus_best_version" "$quartus_candidate_version" && return 1

    if [ "$quartus_candidate_edition" != Pro ] && [ "$quartus_best_edition" = Pro ]
    then
        return 0
    fi

    # Stable collection order resolves all remaining ties.
    return 1
}

quartus_consider_candidate ()
{
    local quartus_root="$1" quartus_bin quartus_seen quartus_output
    local quartus_candidate_version= quartus_candidate_edition=
    local quartus_rejection= quartus_query="$script_dir/fpga/quartus_has_device.tcl"
    local -a quartus_bins=(bin)

    if [ "$OSTYPE" = cygwin ] || [ "$OSTYPE" = msys ]
    then
        quartus_root=$(cygpath -u "$quartus_root") || return 1
        quartus_query=$(cygpath -m "$quartus_query") || return 1
        quartus_bins=(bin64 bin)
    fi

    if ! quartus_root=$(readlink -f "$quartus_root") || [ ! -d "$quartus_root" ]
    then
        warning "Quartus directory '$1' does not exist."

        return 0
    fi

    for quartus_seen in "${quartus_seen_roots[@]}"
    do
        [ "$quartus_seen" = "$quartus_root" ] && return 0
    done

    quartus_seen_roots+=("$quartus_root")
    quartus_warn_install_path "$quartus_root"

    for quartus_bin in "${quartus_bins[@]}"
    do
        if [ ! -x "$quartus_root/$quartus_bin/quartus$exe" ] ||
           [ ! -x "$quartus_root/$quartus_bin/quartus_sh$exe" ] ||
           [ ! -x "$quartus_root/$quartus_bin/quartus_pgm$exe" ]
        then
            if [ -z "$quartus_rejection" ]
            then
                quartus_rejection="Missing executable GUI, shell, or programmer in ${quartus_bins[*]}."
            fi

            continue
        fi

        quartus_read_identity "$quartus_root" "$quartus_bin" || continue

        if ! quartus_family_compatible "$quartus_candidate_version" "$quartus_candidate_edition"
        then
            quartus_rejection="$quartus_candidate_edition $quartus_candidate_version is incompatible with $quartus_target_part or the wrapper's version limit."
            break
        fi

        # Scope QUARTUS_ROOTDIR to this process; an incoming override must not redirect it.
        # The Tcl helper checks installed parts only, without checking licenses.

        if ! quartus_output=$(QUARTUS_ROOTDIR="$quartus_root" \
            "$quartus_root/$quartus_bin/quartus_sh$exe" -t "$quartus_query" "$quartus_target_part" 2>&1) ||
           [[ "$quartus_output" != *"BGM_DEVICE_SUPPORTED=$quartus_target_part"* ]]
        then
            quartus_rejection="Device database query failed for $quartus_target_part; check installed device packages and tool dependencies."
            continue
        fi

        if quartus_candidate_better
        then
            quartus_best_root="$quartus_root"
            quartus_best_bin="$quartus_bin"
            quartus_best_version="$quartus_candidate_version"
            quartus_best_edition="$quartus_candidate_edition"
        fi

        return 0
    done

    warning "Skipping Quartus '$quartus_root'." "$quartus_rejection"
}

quartus_choose_candidates ()
{
    local quartus_candidate

    for quartus_candidate in "${quartus_candidates[@]}"
    do
        quartus_consider_candidate "$quartus_candidate"
    done

    [ -n "$quartus_best_root" ]
}

quartus_activate ()
{
    local quartus_selected_bin="$quartus_best_root/$quartus_best_bin"
    local quartus_entry quartus_remaining="${PATH-}" quartus_new_path="$quartus_selected_bin"

    # Retain the original PATH order and empty entries, removing duplicate selected bins.

    while [ -n "$quartus_remaining" ]
    do
        # %% removes the longest colon suffix, leaving the first PATH entry.
        quartus_entry=${quartus_remaining%%:*}

        if [ "$quartus_entry" != "$quartus_selected_bin" ]
        then
            quartus_new_path+=":$quartus_entry"
        fi

        [[ "$quartus_remaining" = *:* ]] || break

        # # removes the first PATH entry and its colon separator.
        quartus_remaining=${quartus_remaining#*:}

        [ -n "$quartus_remaining" ] || quartus_new_path+=:
    done

    export QUARTUS_ROOTDIR="$quartus_best_root"
    export PATH="$quartus_new_path"
    quartus_bin_dir="$quartus_best_bin"
    quartus_full_real_path="$quartus_selected_bin/quartus$exe"
    quartus_sh_full_real_path="$quartus_selected_bin/quartus_sh$exe"
    quartus_pgm_full_real_path="$quartus_selected_bin/quartus_pgm$exe"

    # %/* strips the final path component, like dirname here; Questa still needs this name.
    choosen_version_dir=${quartus_best_root%/*}

    info "Selected Quartus $quartus_best_edition $quartus_best_version for"   \
         "'$fpga_board' ($quartus_target_part), using $quartus_source."       \
         "QUARTUS_ROOTDIR=$QUARTUS_ROOTDIR"
}

quartus_setup ()
{
    local quartus_target_part quartus_parent quartus_override quartus_path_command
    local quartus_best_root= quartus_best_bin= quartus_best_version= quartus_best_edition=
    local quartus_source
    local -a quartus_candidates=() quartus_seen_roots=() quartus_default_parents=()

    if [ "$OSTYPE" = linux-gnu ]
    then
        quartus_default_parents=("$HOME" /opt /tools)

    elif [ "$OSTYPE" = cygwin ] || [ "$OSTYPE" = msys ]
    then
        # These paths correspond to Windows drives C:, D: and E:.
        quartus_default_parents=(/c /d /e)
    else
        error "Quartus discovery does not support OS / platform '$OSTYPE'."

        return 1
    fi

    # Preserve the existing RED OS workaround when called from a run directory.

    if [ "${inside_run_dir-}" = 1 ] && [ ! -f /usr/lib64/libcrypt.so.1 ] &&
       [ -f /usr/lib64/libcrypt.so ]
    then
        ln -sf /usr/lib64/libcrypt.so libcrypt.so.1

        # :+ adds the existing library path and separator only when it is nonempty.
        export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$PWD"
    fi

    quartus_read_target || return 1

    if [ -n "${QUARTUS_ROOTDIR-}" ]
    then
        quartus_candidates=("$QUARTUS_ROOTDIR")
        quartus_source=QUARTUS_ROOTDIR

        if quartus_choose_candidates
        then
            quartus_activate
            return 0
        fi
    fi

    if quartus_path_command=$(type -P "quartus$exe")
    then
        quartus_path_command=$(readlink -f "$quartus_path_command")

        case "$quartus_path_command" in
            */quartus/bin/quartus"$exe" | */quartus/bin64/quartus"$exe")
                # %/* removes the executable filename, equivalent to dirname here.
                quartus_path_command=${quartus_path_command%/*}

                # %/* removes bin or bin64, leaving the Quartus root directory.
                quartus_path_command=${quartus_path_command%/*}

                quartus_candidates=("$quartus_path_command")
                quartus_source=PATH

                if quartus_choose_candidates
                then
                    quartus_activate
                    return 0
                fi
            ;;
            *)
                warning "Quartus on PATH is outside a quartus/bin or quartus/bin64 installation."  \
                        "Set QUARTUS_ROOTDIR to identify its installation; continuing discovery."
            ;;
        esac
    fi

    for quartus_override in INTEL_FPGA_HOME ALTERA_HOME QUARTUS_HOME
    do
        # ! performs indirect expansion; - tolerates an unset public override.
        quartus_parent=${!quartus_override-}

        [ -n "$quartus_parent" ] || continue
        quartus_candidates=()
        quartus_collect_parent "$quartus_parent"
        quartus_source="$quartus_override='$quartus_parent'"

        if quartus_choose_candidates
        then
            quartus_activate
            return 0
        fi

        warning "No compatible Quartus installation under $quartus_source."  \
                "Continuing with lower-priority locations."
    done

    quartus_candidates=()

    for quartus_parent in "${quartus_default_parents[@]}"
    do
        quartus_collect_parent "$quartus_parent"
    done

    quartus_source="default installation parents: ${quartus_default_parents[*]}"

    if quartus_choose_candidates
    then
        quartus_activate
        return 0
    fi

    error "cannot find a compatible Quartus installation for '$fpga_board'"   \
          "($quartus_target_part) under ${quartus_default_parents[*]}."       \
          "Set QUARTUS_ROOTDIR to a specific quartus directory, or set"       \
          "INTEL_FPGA_HOME, ALTERA_HOME or QUARTUS_HOME to the parent of"     \
          "the altera*, intelFPGA* installation directories."

    return 1
}

#-----------------------------------------------------------------------------
#
#   Intel FPGA version of Questa by Siemens EDA (former Mentor Graphics)
#
#-----------------------------------------------------------------------------

altera_setup_questa ()
{
       [ "$OSTYPE" = "linux-gnu" ]  \
    || [ "$OSTYPE" = "cygwin"    ]  \
    || [ "$OSTYPE" = "msys"      ]  \
    || return

    if is_command_available vsim$exe
    then
        vsim_command="vsim$exe"
        vcover_command="vcover$exe"

        return  # Already set up
    fi

    [ -n "${choosen_version_dir-}" ] ||
        error "Intel FPGA Quartus was supposed to be setup first. "  \
              "Probably internal error."

    #-------------------------------------------------------------------------

    questa_dir=questa_fse

    if [ "$OSTYPE" = "linux-gnu" ]
    then
        questa_bin_dir=bin
        questa_lib_dir=linux_x86_64

    elif  [ "$OSTYPE" = "cygwin"    ]  \
       || [ "$OSTYPE" = "msys"      ]
    then
        questa_bin_dir=win64
        questa_lib_dir=win64
    else
        error "this script does not support your OS / platform '$OSTYPE'"
    fi

    #-------------------------------------------------------------------------

    default_lm_license_file="$HOME/flexlm/license.dat"

    if [ -f "$default_lm_license_file" ]
    then
        if [ -z "${LM_LICENSE_FILE-}" ] ; then
            export LM_LICENSE_FILE="$default_lm_license_file"
        fi

        if [ -z "${MGLS_LICENSE_FILE-}" ] ; then
            export MGLS_LICENSE_FILE="$default_lm_license_file"
        fi
    fi

    #-------------------------------------------------------------------------

    # Check if Quartus is installed without Questa
    [ -d "$choosen_version_dir/$questa_dir" ] || return 0

    export PATH="${PATH:+$PATH:}$choosen_version_dir/$questa_dir/$questa_bin_dir"
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$choosen_version_dir/$questa_dir/$questa_lib_dir"

    vsim_command="$choosen_version_dir/$questa_dir/$questa_bin_dir/vsim$exe"
    vcover_command="$choosen_version_dir/$questa_dir/$questa_bin_dir/vcover$exe"

    #-------------------------------------------------------------------------

                [ -d "$choosen_version_dir/$questa_dir/$questa_bin_dir" ] ||
    error "directory '$choosen_version_dir/$questa_dir/$questa_bin_dir' expected"

                      [ -f "$vsim_command" ] ||
    error "executable file '$vsim_command' expected"

                      [ -f "$vcover_command" ] ||
    error "executable file '$vcover_command' expected"

    #          [ -x "$vsim_command" ] ||
    # warning "file '$vsim_command' is not executable."  \
    #         "Questa is installed with incorrect permissions?"

    #          [ -x "$vcover_command" ] ||
    # warning "file '$vcover_command' is not executable."  \
    #         "Questa is installed with incorrect permissions?"
}

#-----------------------------------------------------------------------------

questa_script=../questa.tcl
[ "$OSTYPE" = "linux-gnu" ] && [ "${USER:-}" = panchul ] && questa_script=../questa2.tcl
# USER might be not set in Apple Mac

run_questa ()
{
    error_prefix="This example is supposed to be run with Questa simulator. However,"

       [ "$OSTYPE" = "linux-gnu" ]  \
    || [ "$OSTYPE" = "cygwin"    ]  \
    || [ "$OSTYPE" = "msys"      ]  \
    || error "$error_prefix this simulator does not run under OS / platform '$OSTYPE'"

    if [ -z "${LM_LICENSE_FILE-}" ]
    then
        if [ -z "${MGLS_LICENSE_FILE-}" ]
        then
            warning "$error_prefix neither variable LM_LICENSE_FILE"  \
                    "nor MGLS_LICENSE_FILE is set."                   \
                    "Probably script got confused"                    \
                    "with multiple Quartus directories."

        elif ! [ -f "$MGLS_LICENSE_FILE" ]
        then
            warning "$error_prefix your variable LM_LICENSE_FILE is not set"  \
                    "and the default license file '$MGLS_LICENSE_FILE'"       \
                    "does not exist."                                         \
                    "You may need to resolve the licensing issues."
        fi
    fi

    if ! is_command_available "$vsim_command"
    then
        error "$error_prefix '$vsim_command' executable is not available."  \
              "Have you installed the simulator, either"                    \
              "together with Quartus package or separately?"
    fi

    if grep 'add wave' $questa_script ; then
        vsim_options=-gui
    else
        vsim_options=-c
    fi

    "$vsim_command" $vsim_options -do $questa_script 2>&1
    cp transcript "$log"

    if [ -f coverage.ucdb ] ; then
        "$vcover_command" report -details -html coverage.ucdb
    fi
}

#-----------------------------------------------------------------------------
#
#   Intel FPGA boards
#
#-----------------------------------------------------------------------------

setup_run_directory_for_fpga_synthesis_quartus ()
{
    dir="$1"
    main_src_dir="$2"

    #-------------------------------------------------------------------------

    # We need relative paths here because Quartus under Windows
    # does not like /c/... full paths.

    # We don't need quotation marks around relative paths
    # because these particular relative paths
    # are expected to contain only alnums, underscores and slashes.

    rel_main_src_dir=$(realpath   --relative-to="$dir" "$main_src_dir")
    rel_board_dir=$(realpath      --relative-to="$dir" "$board_dir")
    rel_peripheral_dir=$(realpath --relative-to="$dir" "$peripheral_dir")
    rel_lab_dir=$(realpath        --relative-to="$dir" "$lab_dir")

    #-------------------------------------------------------------------------

    > "$dir/fpga_project.qpf"

    cat << EOF > "$dir/fpga_project.qsf"
set_global_assignment -name NUM_PARALLEL_PROCESSORS  4
set_global_assignment -name TOP_LEVEL_ENTITY         board_specific_top
set_global_assignment -name SDC_FILE                 $rel_board_dir/$fpga_board/board_specific.sdc

set_global_assignment -name SEARCH_PATH $rel_main_src_dir
set_global_assignment -name SEARCH_PATH $rel_board_dir/$fpga_board
set_global_assignment -name SEARCH_PATH $rel_peripheral_dir
set_global_assignment -name SEARCH_PATH $rel_lab_dir/common

set_global_assignment -name SEARCH_PATH ../cpu
set_global_assignment -name VERILOG_MACRO "INTEL_VERSION"

EOF

    $find_to_run  \
        "$main_src_dir" "$board_dir/$fpga_board" "$peripheral_dir" "$lab_dir/common"  \
        -type f -name '*.sv' -not -name tb.sv  \
        -printf "set_global_assignment -name SYSTEMVERILOG_FILE %P\n"  \
        >> "$dir/fpga_project.qsf"

    if [ -f "$main_src_dir/extra_project_files.qsf" ] ; then
        cat "$main_src_dir/extra_project_files.qsf" >> "$dir/fpga_project.qsf"
    fi

    cat "$board_dir/$fpga_board/board_specific.qsf" >> "$dir/fpga_project.qsf"

    $find_to_run "$board_dir/$fpga_board"  \
                 -name '*.qsf'             \
               ! -name board_specific.qsf  \
                 -exec cp {} "$dir"        \;
}

#-----------------------------------------------------------------------------
#
#   Synthesis and configuration
#
#-----------------------------------------------------------------------------

synthesize_for_fpga_quartus ()
{
    is_command_available_or_error "$quartus_sh_full_real_path" " from Intel FPGA Quartus Prime package"

    if ! "$quartus_sh_full_real_path" --no_banner --flow compile fpga_project 2>&1 | tee -a "$log"
    then
        grep -i -A 5 error "$log" 2>&1
        error "synthesis failed"
    fi
}

#-----------------------------------------------------------------------------

# Need to put detailed dump to debug MEI situation

configure_fpga_quartus ()
{
    is_command_available_or_error "$quartus_pgm_full_real_path" " from Intel FPGA Quartus Prime package"

    #-------------------------------------------------------------------------

    if [ "$OSTYPE" = "linux-gnu" ]
    then
        rules_dir=/etc/udev/rules.d
        rules_file="$script_dir/fpga/90-intel-fpga.rules"

        # TODO: Proposed change
        # if ! grep -q "USB[- ]Blaster" $rules_dir/*

        if ! grep -q USB-Blaster $rules_dir/*
        then
            error "No rules for USB Blaster detected in $rules_dir."  \
                  "Please put it there and reboot: sudo cp $rules_file $rules_dir"
        fi

        killall jtagd 2>/dev/null || true
    fi

    #-------------------------------------------------------------------------

    "$quartus_pgm_full_real_path" -l &> cable_list

    cable_name_1=$(set +o pipefail; grep "1) " cable_list | sed 's/.*1) //')
    cable_name_2=$(set +o pipefail; grep "2) " cable_list | sed 's/.*2) //')

    if [ -n "$cable_name_1" ]
    then
        if [ -n "$cable_name_2" ]
        then
            warning "more than one cable is connected:" \
                    "$cable_name_1 and $cable_name_2"
        fi

        info "using cable $cable_name_1"

        config_file_1=fpga_project.sof
        config_file_2=fpga_project.pof

        config_file=$config_file_1

        if ! [ -f $config_file ]
        then
            config_file=$config_file_2

            if ! [ -f $config_file ]
            then
                error "Neither $config_file_1 nor $config_file_2" \
                    "config file is available"
            fi
        fi

        # Cyclone V SE/SX/ST is an SOC with an ARM processor.
        # ARM is the first at the jtag and FPGA is the second.
        # Need for a special quartus_pgm call.

        # Get the device name from qsf file

        device_str=$(grep DEVICE "$board_dir/$fpga_board/board_specific.qsf")
        device_name=none

        for word in $device_str
        do
            if [[ $word =~ 5C ]]
            then
                device_name=${word:0:4}
                break
            fi
        done

        # Check the device name

        if [ $fpga_board = de1_soc ] || [ $fpga_board = de10_nano ]
        then
            # TODO: Proposed change
            # "$quartus_pgm_full_real_path" --no_banner -c "$cable_name_1" --mode=jtag -o "P;$config_file@1"

            "$quartus_pgm_full_real_path" --no_banner -c "$cable_name_1" --mode=jtag -o "P;$config_file@2"
        else
            "$quartus_pgm_full_real_path" --no_banner -c "$cable_name_1" --mode=jtag -o "P;$config_file"
        fi
    else
        # TODO: Put check for error in WSL
        # if [ "$OSTYPE" = "linux-gnu" ] && [ -n "${WSL_DISTRO_NAME-}" ]

        error "cannot detect a USB-Blaster cable connected"  \
              "for $fpga_board FPGA board"
    fi

    rm -f cable_list
}

#-----------------------------------------------------------------------------

run_fpga_synthesis_gui_quartus ()
{
    is_command_available_or_error "$quartus_full_real_path" " from Intel FPGA Quartus Prime package"

    setup_run_directory_for_fpga_synthesis

    "$quartus_full_real_path" fpga_project.qpf &
}
