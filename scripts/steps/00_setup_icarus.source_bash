expected_source_script=00_setup.source_bash

if [ -z "$BASH_SOURCE" ]
then
    printf "script \"%s\" should be sourced from \"%s\"\n"  \
        "$0" "$expected_source_script" 1>&2

    exit 1
fi

this_script=$(basename "${BASH_SOURCE[0]}")
source_script=$(basename "${BASH_SOURCE[1]}")

if [ -z "$source_script" ]
then
    printf "script \"%s\" should be sourced from  \"%s\"\n"  \
        "$this_script" "$expected_source_script" 1>&2

    return 1
fi

if [ "$source_script" != $expected_source_script ]
then
    printf "script \"%s\" should be sourced from  \"%s\", not \"%s\"\n"  \
        "$this_script" "$expected_source_script" "$source_script" 1>&2

    exit 1
fi

#-----------------------------------------------------------------------------

icarus_verilog_setup ()
{
    if is_command_available iverilog ; then
        return  # Already set up
    fi

    if    [ "$OSTYPE" = "cygwin"    ]  \
       || [ "$OSTYPE" = "msys"      ]
    then
        alt_icarus_install_path="/c/iverilog"

        if [ -d "$alt_icarus_install_path" ]
        then
            export PATH="${PATH:+$PATH:}$alt_icarus_install_path/bin:$alt_icarus_install_path/gtkwave/bin"
        fi
    else
        alt_icarus_install_path="$HOME/install/iverilog"

        if [ -d "$alt_icarus_install_path" ]
        then
            export PATH="${PATH:+$PATH:}$alt_icarus_install_path/bin"
            export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$alt_icarus_install_path/lib"
        fi
    fi
}

#-----------------------------------------------------------------------------

# Sets icarus_language_option, which the caller declares local.

icarus_verilog_choose_language_option ()
{
    icarus_language_option=-g2012

    local version_output
    version_output=$(iverilog -V 2>&1)

    if [[ $version_output =~ Icarus[[:space:]]Verilog[[:space:]]version[[:space:]]([0-9]+)\. ]]
    then
        local major=${BASH_REMATCH[1]}

        if (( major < 11 ))
        then
            warning "Icarus Verilog $major is too old for reliable"   \
                    "simulation of the examples in this repository."  \
                    "Upgrade to version 12 or preferably newer."      \
                    "Continuing with -g2012."

        elif (( major == 11 ))
        then
            warning "Icarus Verilog 11 detected. We recommend"     \
                    "switching to version 12, preferably 13 or"    \
                    "the current development version, future 14."  \
                    "Continuing with -g2012."

        elif (( major >= 14 ))
        then
            # Stable 13.0 supports language generations only through 2012.
            # Development builds numbered 14 may predate -g2023, so probe it.

            if iverilog -g2023 -E -o /dev/null /dev/null > /dev/null 2>&1
            then
                icarus_language_option=-g2023
            else
                warning "This build of Icarus Verilog $major"  \
                        "does not accept -g2023."              \
                        "Continuing with -g2012."
            fi
        fi
    else
        warning "Cannot determine the Icarus Verilog version."  \
                "Continuing with -g2012."
    fi
}

#-----------------------------------------------------------------------------

run_icarus_verilog ()
{
    is_command_available_or_error_and_install iverilog

    local icarus_language_option
    icarus_verilog_choose_language_option

    rars_assembly

    #-------------------------------------------------------------------------

    # If the lab has sv_file_list.f, compile the lab's own files in the
    # order the list gives, instead of all ../*.sv and ../*.v files.
    # This is needed when a package has to be compiled before the files
    # that import it. The list has to include tb.sv. Its paths are
    # relative to the lab directory, as in the Vivado flow.

    local sv_file_list=../sv_file_list.f
    local lab_sv_files=()
    local lab_v_files=()
    local line

    shopt -s nullglob

    if [ -f "$sv_file_list" ]
    then
        while IFS= read -r line || [ -n "$line" ]
        do
            # ${line%$'\r'} removes a trailing carriage return,
            # so a list with Windows line endings works too
            line=${line%$'\r'}

            if [ -n "$line" ]
            then
                lab_sv_files+=("../$line")
            fi
        done < "$sv_file_list"
    else
        lab_sv_files=(../*.sv)
        lab_v_files=(../*.v)
    fi

    # ${array[@]+"${array[@]}"} expands to the array elements, or to nothing
    # for an empty array; a plain "${array[@]}" fails under set -u in Bash
    # older than 4.4, such as the Bash 3.2 that comes with macOS
    iverilog "$icarus_language_option" -s tb                                 \
         -I .. -I ../cpu -I "$lab_dir/common" -I "$package_dir/peripherals"  \
            ${lab_sv_files[@]+"${lab_sv_files[@]}"}                          \
            "$lab_dir/common"/*.sv "$package_dir/peripherals"/*.sv           \
            ${lab_v_files[@]+"${lab_v_files[@]}"}                            \
        2>&1 | tee "$log"

    shopt -u nullglob

    #-------------------------------------------------------------------------

    vvp a.out 2>&1 | tee "$log"

    if grep -m 1 ERROR "$log" ; then
        warning errors detected
    fi

    #-------------------------------------------------------------------------

    dump_vcd=dump.vcd

    if ! [ -f $dump_vcd ]; then
        warning no $dump_vcd file
        return 0
    fi

    is_command_available_or_error_and_install gtkwave

    gtkwave_script=../gtkwave.tcl

    gtkwave_options=

    if [ -f $gtkwave_script ]; then
        gtkwave_options="--script $gtkwave_script"
    fi

    if    [ "$OSTYPE" = "linux-gnu" ]

    then
        gtkwave=gtkwave

    elif  [ "$OSTYPE" = "cygwin"    ]  \
       || [ "$OSTYPE" = "msys"      ]
    then
        if is_command_available surfer ; then

        gtkwave=surfer

    gtkwave_script=../surfer.scr

    gtkwave_options=

    if [ -f $gtkwave_script ]; then
        gtkwave_options="--command-file $gtkwave_script"
    fi
        else

    is_command_available_or_error_and_install gtkwave

        gtkwave=gtkwave

    gtkwave_script=../gtkwave.tcl

    gtkwave_options=

    if [ -f $gtkwave_script ]; then
        gtkwave_options="--script $gtkwave_script"
    fi
        fi

    elif [[ "$OSTYPE" = "darwin"* ]]
    then
        if [ $(uname -m) = arm64 ]
        then
            is_command_available_or_error_and_install surfer

            gtkwave=surfer

    gtkwave_script=../surfer.scr

    gtkwave_options=

    if [ -f $gtkwave_script ]; then
        gtkwave_options="--command-file $gtkwave_script"
    fi
        else
            # For some reason the following way of opening the application
            # under Mac does not read the script file:
            #
            # open -a gtkwave $dump_vcd --args --script $PWD/gtkwave.tcl
            #
            # This way works:

            gtkwave=/Applications/gtkwave.app/Contents/MacOS/gtkwave-bin
        fi
    else
        error 1 "don't know how to run GTKWave on your OS $OSTYPE"
    fi

    command="$gtkwave $dump_vcd $gtkwave_options"

    if [  "$OSTYPE" = "linux-gnu"  ] ||
       [[ "$OSTYPE" = "darwin"*   ]]
    then
        $command &
    else
        $command
    fi
}
