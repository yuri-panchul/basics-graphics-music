# TM1638 DIO is idle-high when the optional accessory is enabled.
set_instance_assignment -name WEAK_PULL_UP_RESISTOR ON -to {GPIO_0[31]}

# Expansion headers: vendor GPIO0_D/GPIO1_D renamed GPIO_0/GPIO_1.
